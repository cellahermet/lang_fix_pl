msgid "모던 어반 카페"
msgstr "Nowoczesna Kawiarnia w Stylu Urban"

#. Key:	BuildPreset_Gangnam_BusinessSite3_01_DescriptionTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
