msgid "거짓 정보를 퍼트리면 잠시나마 즐거울 거야."
msgstr "Chcę poczuć się lepiej, szerząc fałszywe informacje."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Cooperator_PostMaliciousComment_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
