msgstr "<CatTalk_Title>Brak dostępnych policjantów.</>"

#. Key:	Message_Service_Police_CatchCrime_Finish_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "범죄 신고 후 경찰 상황 종료 안내"
