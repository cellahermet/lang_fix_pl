msgctxt "ST_BuildPreset,BuildPreset_Architecture_Residence_Area01_21_DisplayNameTextId"
msgid "식스룸 콘도"
msgstr "Mieszkanie sześciopokojowe"

#. Key:	BuildPreset_Gangnam_Business_PhotoStudio_01_DescriptionTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
#. InfoMetaData:	"DevComment" : "건축 모드 부지 프리셋 툴팁용 강남 비즈니스 포토 스튜디오 01 뉴스룸 설명"
