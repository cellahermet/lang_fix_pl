#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_CatOperatorMessage.ST_CatOperatorMessage
msgctxt "ST_CatOperatorMessage,CatOperatorMessage_msg_0007_MessageTextId"
msgid "남자친구와 투투를 챙기는 고등학생 은정이의 하루"
msgstr "Ktoś naprawdę obchodzi rocznicę po 22 dniach. Vlog EJ — zwykłej licealistki"

#. Key:	CatOperatorMessage_msg_0008_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_CatOperatorMessage.ST_CatOperatorMessage
#. InfoMetaData:	"DevComment" : "캣 오퍼레이터 추천 플레이 시나리오 제목(사용처를 찾지 못함)"
#. InfoMetaData:	"IsTranslatable" : "1"
