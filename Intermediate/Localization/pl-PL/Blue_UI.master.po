#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Tag_Empty_Message_Text"
msgid "입력 내용이 없습니다."
msgstr "Treść jest pusta."

#. Key:	Message_Tag_MaxCharError_Message_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "갤러리 업로드 해시태그 입력 시 100자 초과 안내 토스트"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Tag_MaxCharError_Message_Text"
msgid "태그가 너무 길어요. 최대 100자로 조정해주세요."
msgstr "Twój tag jest za długi. Może mieć maksymalnie 100 znaków."

#. Key:	Message_Tag_MaxNumError_Message_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "갤러리 업로드 해시태그 추가 시 최대 개수 초과 토스트"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Tag_MaxNumError_Message_Text"
msgid "태그 개수 초과."
msgstr "Przekroczono maksymalną liczbę tagów."

#. Key:	Message_Tax_Alert_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "공과금 청구 및 가족 최연장자 납부 가능 안내 문자 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Tax_Alert_Text"
msgid "공과금이 청구되었습니다. 가족 중 최연장자가 문자로 공과금을 납부할 수 있습니다."
msgstr "Czas opłacić rachunki domowe. Najstarszy członek rodziny może zrobić to wygodnie przez SMS."

#. Key:	Message_Tax_NotOldest_Family_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "가구 최연장자 외 구성원의 주민세 납부 완료 안내 메시지(사용처를 찾지 못함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Tax_NotOldest_Family_Text"
msgid "주민세 납부가 완료되었습니다."
msgstr "Podatek rezydenta został opłacony."

#. Key:	Message_Toast_Crime_Schedule_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "오늘 밤 범죄 목표 설정 후 일정표 확인을 안내하는 토스트 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Toast_Crime_Schedule_Text"
msgid "오늘 밤 목표가 정해졌습니다. 일정표를 확인하세요."
msgstr "Dzisiejszy cel został ustalony. Sprawdź swój harmonogram."

#. Key:	Message_ToastMessage_NoSeat_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "TV 게임 상호작용 시 앉을 자리가 없을 때 표시되는 토스트 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_ToastMessage_NoSeat_Text"
msgid "앉을 수 있는 자리가 없습니다."
msgstr "Brak miejsca do siedzenia."

#. Key:	Message_TryToAdoption_SystemMessage_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "아이 입양 제안 상호작용 시 미구현 기능 안내 시스템 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_TryToAdoption_SystemMessage_Text"
msgid "아이 입양은 개발 중입니다."
msgstr "Funkcja adopcji jest obecnie w trakcie rozwoju."

#. Key:	Message_UnablePutdownInInventoryObject_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "차량 내부에서 물건 내려놓기 불가 시 노출되는 상호작용 취소 토스트"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_UnablePutdownInInventoryObject_Text"
msgid "차 안에서는 물건을 내려놓을 수 없습니다."
msgstr "Nie można odkładać przedmiotów, będąc w pojeździe."

#. Key:	Message_Unauthorized_GaragePad_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "차량 차고 소환 시 권한 없는 주차 자리에 표시되는 토스트"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Unauthorized_GaragePad_Text"
msgid "거주자 우선 주차 구역이므로 사용할 수 없습니다."
msgstr "Ten obszar jest wyznaczony jako parking z priorytetem dla mieszkańców, dlatego nie jest dostępny do użytku."

#. Key:	Message_UnauthorizedGaragePadMessage_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "권한 없는 주차 자리 상호작용 차단 안내 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_UnauthorizedGaragePadMessage_Text"
msgid "사용 권한이 없는 주차 자리입니다."
msgstr "Nie masz uprawnień do korzystania z tego miejsca parkingowego."

#. Key:	Message_Vehicle_AllPassengersMustBeSeatedMessage_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "차량 운행 시 모든 승객 착석 필요 안내 토스트"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Vehicle_AllPassengersMustBeSeatedMessage_Text"
msgid "모든 승객이 자리에 앉아야 운행 가능합니다."
msgstr "Wszyscy pasażerowie muszą siedzieć, aby zacząć jazdę."

#. Key:	Message_Vehicle_CommonReturnToParkingPlaceMessage_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "탈것 귀환 명령 후 주차 완료 안내 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Vehicle_CommonReturnToParkingPlaceMessage_Text"
msgid "탈것이 주차되었습니다."
msgstr "Twój pojazd jest zaparkowany."

#. Key:	Message_Vehicle_GroundClickMessage_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "도시 편집에서 목적지 선택 후 탈것 이동 방법을 안내하는 메시지 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Vehicle_GroundClickMessage_Text"
msgid "도시 편집에서 목적지를 선택하고 '탈것을 통해 이동'을 클릭하면 이동할 수 있습니다."
msgstr "Wybierz cel w menu Edytowanie miasta i kliknij Jedź tutaj, aby udać się do tej lokalizacji."

#. Key:	Message_Vehicle_LaneDeviationWarningMessage_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "탈것 주행 중 차선 이탈 및 자동 차선 복귀 예정 안내 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Vehicle_LaneDeviationWarningMessage_Text"
msgid "차선을 벗어났습니다. 차선에 복귀하지 않으면, 탈것이 자동으로 원래 차선으로 복귀합니다."
msgstr "Zjeżdżasz z pasa. Jeśli nie wrócisz na swój pas, pojazd zrobi to automatycznie."

#. Key:	Message_Vehicle_LaneReturnCompleteMessage_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "탈것 주행 중 차선 이탈 후 인근 차선 복귀 완료 안내 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Vehicle_LaneReturnCompleteMessage_Text"
msgid "탈것이 차선을 벗어나 인근 차선으로 복귀했습니다."
msgstr "Pojazd zjechał z pasa i wrócił na pobliski pas."

#. Key:	Message_Vehicle_ManualDrivingNotAllowed_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "차량 조작 입력 시 자동 운전 상태라 수동 운전이 불가함을 알리는 토스트 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Vehicle_ManualDrivingNotAllowed_Text"
msgid "자동 운전 모드일 때는 직접 운전할 수 없습니다."
msgstr "W trybie automatycznej jazdy prowadzenie ręczne jest wyłączone."

#. Key:	Message_Vehicle_MotorcycleSpawnFailedMessage_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "오토바이 소환 불가 위치 안내 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Vehicle_MotorcycleSpawnFailedMessage_Text"
msgid "탈 것을 가져올 수 없는 위치에 있습니다. 다른 자리에서 시도해주세요."
msgstr "Nie można tutaj odzyskać pojazdu. Spróbuj w innym miejscu."

#. Key:	Message_Vehicle_MoveWithVehicleArriveMessage_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "차량 이동 목적지 도착 시 표시되는 토스트 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Vehicle_MoveWithVehicleArriveMessage_Text"
msgid "목적지에 도착하였습니다."
msgstr "Dojechano na miejsce."

#. Key:	Message_Vehicle_MoveWithVehicleCancelMessage_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "탈것 자동 이동 취소 시 출력되는 알림 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Vehicle_MoveWithVehicleCancelMessage_Text"
msgid "탈것을 이용한 자동 이동이 취소되었습니다."
msgstr "Automatyczne poruszanie przy użyciu pojazdu zostało anulowane."

#. Key:	Message_Vehicle_MoveWithVehicleFailedMessage_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "탈것 자동 이동 경로 탐색 실패 시 도보 이동 가능 안내 토스트"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Vehicle_MoveWithVehicleFailedMessage_Text"
msgid "탈것을 통해 갈 수 없는 지역입니다. 도보로는 이동 가능합니다."
msgstr "Ten obszar jest niedostępny dla pojazdów. Możesz dostać się tu pieszo."

#. Key:	Message_Vehicle_NonOwnerInDriverSeatMessage_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "비소유 탈것 운전 시도 시 노출되는 운전 불가 토스트 알림"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
