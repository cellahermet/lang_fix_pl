#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
msgctxt "ST_BuildPreset,BuildPreset_Gangnam_Business_PhotoStudio_01_DisplayNameTextId"
msgid "뉴스룸"
msgstr "Newsroom"

#. Key:	BuildPreset_Gangnam_Business_PhotoStudio_02_DescriptionTextId
