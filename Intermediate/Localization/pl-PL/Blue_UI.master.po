#: /Game/Data/String/UI/ST_CatOperatorMessage.ST_CatOperatorMessage
msgctxt "ST_CatOperatorMessage,CatOperatorMessage_msg_0010_MessageTextId"
msgid "꼰대들만 가득한 중소기업에서 MZ하게 일해보자!"
msgstr "Życie milenialsa pracującego w małej firmie pełnej staruszków"

#. Key:	CatOperatorMessage_msg_0011_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_CatOperatorMessage.ST_CatOperatorMessage
#. InfoMetaData:	"DevComment" : "(사용처를 찾지 못함)"
#. InfoMetaData:	"IsTranslatable" : "1"
