#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Lazy_CallCleaner_MessageTextId"
msgid "직접 청소하기 귀찮으니 대신 청소해 줄 사람을 불렀으면 해."
msgstr "Nie chcę sprzątać, wolę zamówić usługę, żeby ktoś zrobił to za mnie."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Lazy_DozenSit_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "게으름 특성의 꾸벅 앉기 상태 기본 말풍선"
