#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Save_AutoSaveToast_Text"
msgid "{FileName} 자동 저장되었습니다."
msgstr "Plik {FileName} został automatycznie zapisany."

#. Key:	Message_Save_NotEnoughSpaceOnDrive_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "저장 경로 디스크 여유 공간 1GB 이하일 때 노출되는 저장 불가 토스트"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Save_NotEnoughSpaceOnDrive_Text"
msgid "하드디스크 용량이 부족합니다. 확인이 필요합니다."
msgstr "Brak wystarczającego miejsca na dysku. Sprawdź dostępne zasoby."

#. Key:	Message_Save_PreAutoSaveToast_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "자동 저장 시작 전 게임 종료 금지 안내 토스트"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Save_PreAutoSaveToast_Text"
msgid "게임을 자동 저장합니다. 저장 중에는 게임을 종료하지 마세요."
msgstr "Twoja gra jest automatycznie zapisywana. Nie wychodź z gry podczas zapisywania."

#. Key:	Message_Save_TooLargeSaveFolderSize_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "세이브 폴더 총용량 한계 임박 시 표시되는 토스트 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Save_TooLargeSaveFolderSize_Text"
msgid "세이브 폴더의 용량이 곧 한계입니다. 정리가 필요합니다."
msgstr "Twój folder z zapisami jest prawie pełny. Usuń niepotrzebne pliki."

#. Key:	Message_Save_TooManySaveFilesNum_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "세이브 파일 개수 한도 도달 시 불러오기 창 정리 안내 토스트"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Save_TooManySaveFilesNum_Text"
msgid "세이브 용량이 부족합니다. [ESC] - 불러오기 창에서 오래된 세이브 파일을 정리해주세요."
msgstr "Za mało miejsca na zapis. Usuń stare pliki zapisu, wybierając [ESC] — Menu wczytywania."

#. Key:	Message_Schedule_FriendVisitArrived_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "친구 방문 일정에서 방문자 도착 직후 호스트에게 보내는 도착 알림 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Schedule_FriendVisitArrived_Text"
msgid "나 도착했어. 말 걸어주지 않으면 계속 기다릴 거야! 반갑게 맞아줄 거지?"
msgstr "Hej, jestem na miejscu! Do zobaczenia za chwilę!"

#. Key:	Message_Schedule_FriendVisitOpen_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "친구 방문 일정에서 방문자 도착 직후 호스트가 보내는 맞이 응답 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Schedule_FriendVisitOpen_Text"
msgid "오 도착했구나 당연하지 지금 나갈게 기다려줘"
msgstr "O, już jesteś! Poczekaj chwilkę, zaraz przyjdę!"

#. Key:	Message_Schedule_FriendVisitStart_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "{SiteName}: 방문 약속 목적지의 부지명입니다(예: 중앙공원 / AZ편의점 / 센트럴 마켓)."
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Schedule_FriendVisitStart_Text"
msgid "지금 {SiteName}|hpp(으로,로) 만나러 갈게. 기다리고 있어!"
msgstr "Jestem w drodze do {SiteName}. Zaraz tam będę!"

#. Key:	Message_ScheduleEdit_EditLockedByJob_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "일정 편집 화면에서 학교·직장 일정 수정 불가 안내 메시지 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_ScheduleEdit_EditLockedByJob_Text"
msgid "학교 및 직장과 관련된 일정은 변경할 수 없습니다."
msgstr "Nie można zmieniać wpisów w harmonogramie związanych ze szkołą lub pracą."

#. Key:	Message_ScheduleEdit_EditLockedByScheduleIntersection_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "일정 편집 화면에서 기존 일정과 겹치는 위치로 이동하려 할 때 표시되는 토스트 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_ScheduleEdit_EditLockedByScheduleIntersection_Text"
msgid "기존의 다른 일정과 겹치는 위치로 일정을 옮길 수 없습니다."
msgstr "Nie można dodać nowego wpisu w harmonogramie jeśli nakłada się na inny, istniejący już, wpis."

#. Key:	Message_ScheduleEdit_MinTimeUnsatisfied_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "일정 편집 시 최소 2시간 조건 미충족 안내 문구"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_ScheduleEdit_MinTimeUnsatisfied_Text"
msgid "하나의 일정은 최소 2시간이 필요합니다."
msgstr "Do harmonogramu można dodawać tylko wpisy trwające co najmniej dwie godziny."

#. Key:	Message_ScheduleEdit_WorkingScheduleMinTimeUnsatisfied_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "{0}: 직장 스케줄 최소 근무시간(시간 단위 정수)입니다(예: 4 / 6 / 8)."
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_ScheduleEdit_WorkingScheduleMinTimeUnsatisfied_Text"
msgid "해당 직장 스케줄은 {0}시간 이하로 설정할 수 없습니다."
msgstr "Wpisy w harmonogramie dla tego miejsca pracy muszą być dłuższe niż {0} godz."

#. Key:	Message_ScheduleEditTooltip_EditLockedByAge_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "신생아·유아 일정 추가 불가 안내 툴팁 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_ScheduleEditTooltip_EditLockedByAge_Text"
msgid "<img id=\"Alert_Red\"/><Alert_desc> 신생아, 유아는 일정을 추가할 수 없습니다.</>"
msgstr "<img id=\"Alert_Red\"/><Alert_desc>Nie można dodawać wpisów w harmonogramie dla noworodków i małych dzieci.</>"

#. Key:	Message_ScheduleEditTooltip_MinTimeUnsatisfied_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "일정 편집 툴팁, 최소 2시간 이상으로만 일정 생성 가능 안내 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_ScheduleEditTooltip_MinTimeUnsatisfied_Text"
msgid "<img id=\"Alert_Red\"/><Alert_desc> 일정 생성은 최소 2시간 이상 필요합니다.</>"
msgstr "<img id=\"Alert_Red\"/><Alert_desc>Można tworzyć tylko wpisy w harmonogramie trwające co najmniej dwie godziny.</>"

#. Key:	Message_ScheduleSiteExit_Desc_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "{ScheduleName}: 복귀해야 하는 일정명입니다(예: 직장 / 자유시간 / 선셋 윙). {time}: 남은 시간 분 단위 정수값입니다(예: 5 / 30 / 120)."
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_ScheduleSiteExit_Desc_Text"
msgid "{ScheduleName}|hpp(으로, 로) 돌아가지 않으면\r\n일정이 취소됩니다.\r\n\r\n남은 시간 : {time}분"
msgstr "Twój wpis w harmonogramie zostanie usunięty, jeśli nie wrócisz do {ScheduleName}.\r\nPozostały czas: {time} min."

#. Key:	Message_Service_ChildCare_Adding_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "아이 돌봄 서비스 신청 접수 완료 안내"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Service_ChildCare_Adding_Text"
msgid "신청하신 아이 돌봄 서비스가 정상적으로 접수되었습니다."
msgstr "Twoje zgłoszenie do usługi opieki nad dzieckiem zostało pomyślnie przyjęte."

#. Key:	Message_Service_ChildCare_Failure_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "아이돌보미 부재로 인한 돌봄 서비스 제공 불가 안내"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Service_ChildCare_Failure_Text"
msgid "현재 아이돌보미가 없어, 돌봄 서비스를 제공할 수 없습니다."
msgstr "Obecnie nie ma dostępnych opiekunów. Nie możemy teraz zapewnić opieki nad dzieckiem."

#. Key:	Message_Service_ChildCare_Pending_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "아이돌보미 배정 대기 상태 안내"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Service_ChildCare_Pending_Text"
msgid "돌봄 서비스 제공을 위해 아이돌보미를 배정 중입니다. 잠시만 기다려 주세요."
msgstr "Organizujemy opiekę dla twojego dziecka. Poczekaj chwilę."

#. Key:	Message_Service_ChildCare_Success_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "아이 돌봄 서비스 승인 및 아이돌보미 방문 안내 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Service_ChildCare_Success_Text"
msgid "신청하신 아이 돌봄 서비스가 승인되어 아이돌보미가 집으로 오고 있습니다."
msgstr "Twoje zgłoszenie do usługi opieki nad dzieckiem zostało pomyślnie przyjęte."

#. Key:	Message_Service_ChildCare_TimeOut_Finish_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "아이 돌봄 서비스 운영 종료 완료 안내 메시지 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Service_ChildCare_TimeOut_Finish_Text"
msgid "우리 아이 돌봄 서비스 운영 시간이 종료되었습니다."
msgstr "Opieka nad dzieckiem dobiegła końca na dziś."

#. Key:	Message_Service_ChildCare_TimeOut_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "아이 돌봄 서비스 운영 시간 종료 안내 메시지 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Service_ChildCare_TimeOut_Text"
msgid "우리 아이 돌봄 서비스 운영 시간이 종료되었습니다."
msgstr "Opieka nad dzieckiem dobiegła końca na dziś."

#. Key:	Message_Service_FireExtinguish_Adding_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "소방 서비스 요청 접수 시 캣톡 알림 제목 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Service_FireExtinguish_Adding_Text"
msgid "<CatTalk_Title>소방서에 화재 진압을 요청했습니다.</>"
msgstr "<CatTalk_Title>Do remizy strażackiej wpłynęło zgłoszenie.</>"

#. Key:	Message_Service_FireExtinguish_Failure_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "소방 서비스 요청 실패 시 캣톡 알림 제목"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Service_FireExtinguish_Failure_Text"
msgid "<CatTalk_Title>현재 출동할 수 있는 소방대원이 없거나 해당 부지에 이미 같은 서비스가 진행중입니다.</>"
msgstr "<CatTalk_Title>Brak dostępnych strażaków lub akcja już trwa w nieruchomości.</>"

#. Key:	Message_Service_FireExtinguish_Finish_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "화재 진압 서비스 완료 알림 제목 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Service_FireExtinguish_Finish_Text"
msgid "<CatTalk_Title>화재 진압 서비스가 정상적으로 완료되었습니다.</>"
msgstr "<CatTalk_Title>Udało się ugasić pożar.</>"

#. Key:	Message_Service_FireExtinguish_Pending_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "소방 서비스 호출 대기 안내 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Service_FireExtinguish_Pending_Text"
msgid "<CatTalk_Title>모든 소방대원이 출동중입니다.</>\r\n잠시만 기다려주세요"
msgstr "<CatTalk_Title>Wszyscy strażacy są obecnie zajęci.</>\r\nPoczekaj chwilę."

#. Key:	Message_Service_FireExtinguish_PendingQueue_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "소방 서비스 호출 대기열 추가 안내 메시지 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Service_FireExtinguish_PendingQueue_Text"
msgid "<CatTalk_Title>[수정요] 화재 진압 대기열에 추가되었습니다.</>\r\n이 텍스트는 수정되어야 합니다."
msgstr "<CatTalk_Title>[Wymaga sprawdzenia] Dodano do kolejki gaszenia.</>\r\nTen tekst wymaga sprawdzenia."

#. Key:	Message_Service_FireExtinguish_Success_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "캣톡 소방서 화재 진압 출동 시작 안내 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Service_FireExtinguish_Success_Text"
msgid "<CatTalk_Title>소방서에서 출동을 시작하였습니다.</>\r\n잠시만 기다려주세요"
msgstr "<CatTalk_Title>Remiza strażacka rozpoczęła działanie.</>\r\nStrażacy wkrótce przybędą na miejsce."

#. Key:	Message_Service_FireExtinguish_TimeOut_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "캣톡에 표시되는 화재 진압 서비스 시간 초과 종료 안내 제목 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Service_FireExtinguish_TimeOut_Text"
msgid "<CatTalk_Title>화재 진압 서비스가 종료되었습니다.</>"
msgstr "<CatTalk_Title>Pożar został ugaszony.</>"

#. Key:	Message_Service_Ghost_Exorcist_Adding_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "영혼인도자 서비스 신고 건 접수 완료 안내 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Service_Ghost_Exorcist_Adding_Text"
msgid "귀하께서 신고하신 사건을 영혼인도자가 접수하였습니다."
msgstr "Twoje zgłoszenie zostało odebrane przez Przewodnika duszy."

#. Key:	Message_Service_Ghost_Exorcist_Failure_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "영혼 사건 신고 시 출동 가능한 영혼인도자 부재 안내 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Service_Ghost_Exorcist_Failure_Text"
msgid "귀하께서 신고하신 사건에 현재 출동할 수 있는 영혼인도자가 없습니다."
msgstr "Brak dostępnego Przewodnika duszy, aby obsłużyć zgłoszony incydent."

#. Key:	Message_Service_Ghost_Exorcist_Finish_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "영혼인도자 출동 신고 처리 완료 서비스 알림 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Service_Ghost_Exorcist_Finish_Text"
msgid "귀하께서 신고하신 사건(영혼인도자 출동)이 처리 완료되었습니다."
msgstr "Twoje zgłoszenie (wysłanie Przewodnika duszy) zostało rozwiązane."

#. Key:	Message_Service_Ghost_Exorcist_Pending_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "영혼인도자 서비스 신고 접수 후 출동 중 안내 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Service_Ghost_Exorcist_Pending_Text"
msgid "신고가 접수되어 영혼인도자가 출동 중입니다.\r\n잠시 기다려주시기 바랍니다."
msgstr "Zgłoszenie zostało odebrane, Przewodnik duszy jest już w drodze.\r\nPoczekaj chwilę."

#. Key:	Message_Service_Ghost_Exorcist_Success_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "유령 퇴치 서비스 접수 성공 안내 메시지"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Service_Ghost_Exorcist_Success_Text"
msgid "접수 완료, 영혼인도자가 출동을 시작하였습니다. \r\n출동에 다소 시간이 걸릴 수 있습니다.\r\n잠시 기다려주시기 바랍니다."
msgstr "Zgłoszenie zostało przetworzone, a Przewodnik duszy został wysłany.\r\nMoże to chwilę potrwać.\r\nPoczekaj chwilę."

#. Key:	Message_Service_Ghost_Exorcist_TimeOut_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "캣톡에 표시되는 영혼인도자 서비스 시간 종료 안내 메시지 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_Service_Ghost_Exorcist_TimeOut_Text"
msgid "영혼인도자 업무 시간이 종료되었습니다."
msgstr "Przewodnik duszy zakończył zmianę. Czas na zasłużony odpoczynek!"

#. Key:	Message_Service_Police_CatchCrime_Adding_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
