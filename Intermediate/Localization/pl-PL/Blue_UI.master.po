msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Cooperator_Punch_MessageTextId"
msgid "반응을 보면 즐거울 거야."
msgstr "Chcę zobaczyć, jak zareaguje."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Cooperator_Runaway_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
