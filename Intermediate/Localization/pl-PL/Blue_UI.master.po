#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Crafting.ST_Crafting
msgctxt "ST_Crafting,Crafting_Art_Child_TitleTextId"
msgid "그림 그리기"
msgstr "Namaluj obraz"

#. Key:	Crafting_Art_DescTextId
#. SourceLocation:	/Game/Data/String/UI/ST_Crafting.ST_Crafting
#. InfoMetaData:	"DevComment" : "제작 UI 그림 그리기 항목 설명 문구"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Crafting.ST_Crafting
msgctxt "ST_Crafting,Crafting_Art_DescTextId"
msgid "캔버스에 생각을 펼쳐보세요! 레벨이 높아질수록 더 많은 작품을 그릴 수 있게되고, 완성된 그림은 판매할 수 있습니다."
msgstr "Wyraź siebie na płótnie! Zwiększ poziom, aby odblokować więcej dzieł sztuki i sprzedawać gotowe obrazy."

#. Key:	Crafting_Art_Irritated_DescTextId
#. SourceLocation:	/Game/Data/String/UI/ST_Crafting.ST_Crafting
