msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Cooperator_StartFight_MessageTextId"
msgid "반응을 보면 즐거울 거야."
msgstr "Chcę zobaczyć, jak zareaguje."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Cooperator_StealItem_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "협력적 특성 심의 물건 훔치기 희망 말풍선"
