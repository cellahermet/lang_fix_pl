#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_UI.ST_UI
msgctxt "ST_UI,UI_FamilyMove_CanNotMove_GrabbedBaby_Text"
msgid "안겨 있는 아기 조이는 이동할 수 없습니다."
msgstr "Nie można przenieść dziecka Zoi, które jest trzymane na rękach."

#. Key:	UI_FamilyMove_CanNotMove_GrabbingBaby_Text
