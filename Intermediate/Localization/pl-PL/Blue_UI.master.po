#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_JobRankDown_Title_Text"
msgid "강등 알림"
msgstr "Powiadomienie o degradacji"

#. Key:	Message_JobRankUp_Desc_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "{0}: 승진 후 직급명입니다(예: 소방장 / 팀장 / 은행장)."
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_JobRankUp_Desc_Text"
msgid "<CatTalk_Title>승진 알림</>\r\n축하한다냥! {0}|hpp(으로,로) 승진하여 새로운 직책을 맡게 됐다냥.<img id=\"Congrats_01\" width=\"22\" height=\"22\"/>\r\n승진하여 새롭게 받게 된 급여 등<img id=\"Congrats_03\" width=\"22\" height=\"22\"/>, \r\n직업 정보는 스마트폰<img id=\"Phone\" width=\"22\" height=\"22\"/>의 직장앱을 살펴보라냥.\r\n\r\n새로운 직책에서도 멋진 활약을 기대한다냥!<img id=\"Congrats_02\" width=\"22\" height=\"22\"/>"
msgstr "<CatTalk_Title>Powiadomienie o awansie</>\r\nGratulacje, miau! Otrzymujesz awans na stanowisko {0}.<img id=\"Congrats_01\" width=\"22\" height=\"22\"/>\r\nAby dowiedzieć się więcej o nowej pensji i szczegółach pracy<img id=\"Congrats_03\" width=\"22\" height=\"22\"/>, \r\nsprawdź aplikację PRACA na smartfonie<img id=\"Phone\" width=\"22\" height=\"22\"/>, miau.\r\n\r\nNie mogę się doczekać, żeby zobaczyć, jak poradzisz sobie w nowej roli!<img id=\"Congrats_02\" width=\"22\" height=\"22\"/>"

#. Key:	Message_JobRankUp_Title_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "같은 직무에서 승진했을 때 표시되는 모바일 알림 제목 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_JobRankUp_Title_Text"
msgid "승진 알림"
msgstr "Powiadomienie o awansie"

#. Key:	Message_JoinCompany_Desc_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "{0}: 입사한 회사명입니다(예: 도원소방서 / 아담엔터테인먼트 / 스리 레스타리 리조트)."
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_JoinCompany_Desc_Text"
msgid "<CatTalk_Title>입사 알림</>\r\n{0} 취업을 축하한다냥!<img id=\"Congrats_01\" width=\"22\" height=\"22\"/>\r\n오늘을 제외한 가장 빠른 근무일부터 출근할 수 있다냥.\r\n\r\n3일 동안 결근하게 될 시 강제로 퇴사 처리되니 주의하라냥.\r\n근무 시간 및 급여 등은 스마트폰<img id=\"Phone\" width=\"22\" height=\"22\"/>의 직장앱을 살펴보라냥~"
msgstr "<CatTalk_Title>Powiadomienie o zatrudnieniu</>\r\nGratulacje z okazji nowej pracy w {0}, miau!<img id=\"Congrats_01\" width=\"22\" height=\"22\"/>\r\nMożesz rozpocząć pracę od następnego dnia roboczego, z pominięciem dzisiejszego.\r\n\r\nPamiętaj, że jeśli nie pojawisz się w pracy przez trzy dni, konieczna będzie rezygnacja.\r\nAby uzyskać szczegółowe informacje o godzinach pracy i wynagrodzeniu, sprawdź aplikację PRACA na swoim smartfonie.<img id=\"Phone\" width=\"22\" height=\"22\"/>"

