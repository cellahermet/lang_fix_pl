msgctxt "ST_Widget,Widget_3DPrinter_GPUGuide_Text"
msgid "GPU를 사용하는 다른 프로그램을 함께 실행하면 게임이 비정상 종료될 수 있습니다."
msgstr "Uruchomienie innych programów, które jednocześnie wykorzystują moc procesora graficznego, może spowodować nieoczekiwane zakończenie gry."

#. Key:	Widget_3DPrinter_Location_AutoGuide_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Widget.ST_Widget
#. InfoMetaData:	"DevComment" : "3D 프린터 오브젝트 위치 조정 가이드 문구"
