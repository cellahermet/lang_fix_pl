#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
msgctxt "ST_BuildPreset,BuildPreset_RedCity_Residence_Mid4_APT_01_DisplayNameTextId"
msgid "모던 패밀리 아파트"
msgstr "Nowoczesne rodzinne mieszkanie"

#. Key:	BuildPreset_RedCity_Residence_Mid4_APT_02_DescriptionTextId
