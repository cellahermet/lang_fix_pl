#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Widget.ST_Widget
msgctxt "ST_Widget,Widget_3DPrinter_FileSizeGuide_Text"
msgid "3D 프린터로 만들어진 오브젝트들이 용량이 클 경우 캔버스에 업로드하지 못할 수 있습니다."
msgstr "Obiektów stworzonych drukarką 3D nie można przesłać do Canvas, jeśli rozmiar pliku jest za duży."

#. Key:	Widget_3DPrinter_GPUGuide_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Widget.ST_Widget
#. InfoMetaData:	"DevComment" : "3D 프린터 GPU 사용 충돌 안내 문구"
