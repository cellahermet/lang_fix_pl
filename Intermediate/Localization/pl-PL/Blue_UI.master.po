msgctxt "ST_BuildPreset,BuildPreset_Gangnam_Residence_Free08_04_DisplayNameTextId"
msgid "초소형 주택"
msgstr "Maleńki domek"

#. Key:	BuildPreset_Gangnam_Residence_Free08_05_DescriptionTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
#. InfoMetaData:	"DevComment" : "건축 프리셋 상세 설명 툴팁 문구"
