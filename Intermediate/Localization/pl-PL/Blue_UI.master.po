msgctxt "ST_BuildPreset,BuildPreset_Architecture_Residence_Area01_20_DisplayNameTextId"
msgid "블루 미니멀 스타일 3층 주택"
msgstr "Minimalistyczny niebieski dom trzypiętrowy"

#. Key:	BuildPreset_Architecture_Residence_Area01_21_DescriptionTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
