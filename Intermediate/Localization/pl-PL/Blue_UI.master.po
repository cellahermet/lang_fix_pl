msgctxt "ST_BuildPreset,BuildPreset_Gangnam_BusinessSite4_01_DisplayNameTextId"
msgid "가든 브릭 베이커리"
msgstr "Cukiernia \"Ceglany Ogród\""

#. Key:	BuildPreset_Gangnam_BusinessSite5_01_DescriptionTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
#. InfoMetaData:	"DevComment" : "건축 프리셋 상세 설명"
