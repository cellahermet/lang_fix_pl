#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Lazy_PlayComputerGame_MessageTextId"
msgid "할 일을 미루고 게임할 때가 가장 즐거워."
msgstr "Granie w gry podczas odkładania obowiązków jest najfajniejsze."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Lazy_QuitJob_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "게으름 특성의 퇴사 희망 말풍선 문구"
