msgctxt "ST_BuildPreset,BuildPreset_Gangnam_Residence_Free08_02_DisplayNameTextId"
msgid "심플 스타일 투룸 빌라"
msgstr "Prosta willa dwupokojowa"

#. Key:	BuildPreset_Gangnam_Residence_Free08_03_DescriptionTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
#. InfoMetaData:	"DevComment" : "건축 모드 사이트 기본 프리셋 목록·툴팁·검색 노출용 강남 주거 Free08_03 설명문"
