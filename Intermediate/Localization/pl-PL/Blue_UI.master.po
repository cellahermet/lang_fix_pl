#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Widget.ST_Widget
msgctxt "ST_Widget,Widget_CatOperator_TraitSortDesc_Text"
msgid "행동을 결정하는 변하지 않는 성격"
msgstr "Niezmienne cechy osobowości określające podejmowane działania"

#. Key:	Widget_CatOperator_TriatDesc_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Widget.ST_Widget
#. InfoMetaData:	"DevComment" : "캣 오퍼레이터 성향 상세 팝업의 성향 정의 안내문"
#. InfoMetaData:	"IsTranslatable" : "1"
