#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_UI.ST_UI
msgctxt "ST_UI,UI_Ghost_Image_Funeral_Title_Text"
msgid "장례식"
msgstr "Pogrzeb"

#. Key:	UI_Ghost_Image_Funeral_Tooltip_Text
#. SourceLocation:	/Game/Data/String/UI/ST_UI.ST_UI
#. InfoMetaData:	"DevComment" : "유령 이미지 UI의 장례식 참관 선택지 툴팁"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_UI.ST_UI
msgctxt "ST_UI,UI_Ghost_Image_Funeral_Tooltip_Text"
msgid "당신의 장례식에 함께하여, 마지막으로 남겨진 이들을 지켜볼 수 있습니다."
msgstr "Weź udział w swoim pogrzebie i przyjrzyj się ostatni raz tym, których opuszczasz."

#. Key:	UI_Ghost_Image_Rebirth_Title_Text
#. SourceLocation:	/Game/Data/String/UI/ST_UI.ST_UI
#. InfoMetaData:	"DevComment" : "유령 이미지 UI의 환생 선택지 제목"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_UI.ST_UI
msgctxt "ST_UI,UI_Ghost_Image_Rebirth_Title_Text"
msgid "환생"
msgstr "Przejdź reinkarnację"

#. Key:	UI_Ghost_Image_Rebirth_Tooltip_Text
#. SourceLocation:	/Game/Data/String/UI/ST_UI.ST_UI
#. InfoMetaData:	"DevComment" : "유령 이미지 UI의 환생 선택지 툴팁"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_UI.ST_UI
msgctxt "ST_UI,UI_Ghost_Image_Rebirth_Tooltip_Text"
msgid "카르마를 모두 채우셨다면, 다른 가문의 인연으로 다시 태어날 수 있습니다.\r\n그러나 주의하십시오. 새로운 삶을 얻는 대신, 이전의 기억은 모두 사라질 수 있습니다."
msgstr "Jeśli spełnisz warunek Karmy, możesz odrodzić się w innej rodzinie.\r\nPamiętaj, że wspomnienia poprzedniego życia znikną i rozpoczniesz nowe życie."

#. Key:	UI_Ghost_Quest_Start_Tooltip_Text
#. SourceLocation:	/Game/Data/String/UI/ST_UI.ST_UI
#. InfoMetaData:	"DevComment" : "유령 부탁 시작 안내 툴팁 문구"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_UI.ST_UI
msgctxt "ST_UI,UI_Ghost_Quest_Start_Tooltip_Text"
msgid "정말로 죽은 것일까요?\r\nAR 도서관의 클레어와 대화를 나눠보세요.\r\n그녀가 당신의 다음 여정에 대해 알려줄 것입니다"
msgstr "Naprawdę nie żyjesz?\r\nPorozmawiaj z Claire w bibliotece AR.\r\nOpowie ci o kolejnej podróży."

#. Key:	UI_Ghost_Quest_Tooltip_Text
#. SourceLocation:	/Game/Data/String/UI/ST_UI.ST_UI
#. InfoMetaData:	"DevComment" : "유령 부탁 퀘스트 진행 안내 툴팁"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_UI.ST_UI
msgctxt "ST_UI,UI_Ghost_Quest_Tooltip_Text"
msgid "도시 곳곳에 배치된 물건들을 활용해 유령의 부탁을 이루세요.\r\n부탁을 해결하면, 클레어를 통해 카르마를 얻을 수 있습니다."
msgstr "Użyj przedmiotów rozrzuconych po mieście, aby zrealizować prośbę ducha.\r\nUkończ ją, aby otrzymać karmę od Claire."

#. Key:	UI_Gift_Currency_Shortage_Text
#. SourceLocation:	/Game/Data/String/UI/ST_UI.ST_UI
#. InfoMetaData:	"DevComment" : "스마트폰 연락처 선물하기 목록에서 소지금 부족 시 비활성화된 선물 버튼 툴팁"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_UI.ST_UI
msgctxt "ST_UI,UI_Gift_Currency_Shortage_Text"
msgid "소지금이 부족하여 선물할 수 없습니다."
msgstr "Nie można podarować z powodu niewystarczających środków."

