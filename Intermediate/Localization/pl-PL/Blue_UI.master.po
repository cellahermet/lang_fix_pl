#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Lazy_SitRest_MessageTextId"
msgid "가만히 앉아있으면 행복할 거야."
msgstr "Chcę posiedzieć bez ruchu."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Lazy_Sunbed_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "게으름 특성의 썬배드 휴식 시 말풍선 문구"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Lazy_Sunbed_MessageTextId"
msgid "썬배드에서 쉬면 시간 가는 줄 모를 거야."
msgstr "Tracę poczucie czasu, odpoczywając na leżaku."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Lazy_ZoneOutTent_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "게으름 특성 ZoneOutTent 행동 말풍선 문구"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Lazy_ZoneOutTent_MessageTextId"
msgid "가만히 앉아서 멍 때리면 행복할 거야."
msgstr "Chcę usiąść i pogrążyć się w myślach."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Leader_AnalysePicture_Preference_SpeechBubble_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "리더 성향 조이의 그림 감상 선호 반응 말풍선 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Leader_AnalysePicture_Preference_SpeechBubble_MessageTextId"
msgid "그림 감상은 별로지만 배울 점은 있지."
msgstr "Nie przepadam za docenianiem sztuki, ale można się z niej czegoś nauczyć."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Leader_AnalysePicture_SpeechBubble_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "리더 특성 인물의 작품 감상 중 말풍선 대사"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Leader_AnalysePicture_SpeechBubble_MessageTextId"
msgid "작품을 통해 리더십을 배워야지."
msgstr "Dzięki sztuce nauczę się więcej o przywództwie."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Leader_Emotion_Bad_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "리더형 특성 부정 감정 상태 의견 무시 불만 머리 위 말풍선 문구"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Leader_Emotion_Bad_MessageTextId"
msgid "내 의견이 존중받지 못하는 건 정말 참기 힘들어."
msgstr "Jest mi trudno, gdy inni nie szanują moich poglądów."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Leader_Emotion_Good_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "리더 특성 캐릭터의 긍정 감정 시 머리 위 말풍선 대사"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Leader_Emotion_Good_MessageTextId"
msgid "주변 사람들을 지키기 위해서는 힘이 있어야 해."
msgstr "Muszę mieć siłę, żeby chronić ludzi wokół siebie."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Leader_Emotion_Irritated_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "리더형 특성 짜증 감정 상태 분노 통제 어려움 말풍선"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Leader_Emotion_Irritated_MessageTextId"
msgid "분노를 통제하기 힘들어."
msgstr "Trudno kontrolować gniew."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Leader_Extinguish_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "화재 상황에서 리더 성향 조이의 통제 의지 말풍선"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Leader_Extinguish_MessageTextId"
msgid "내가 책임지고 이 상황을 통제해야 해."
msgstr "Muszę przejąć inicjatywę i kontrolę nad sytuacją."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Leader_GainSupport_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "리더 특성 지지 세력 확보 의지 말풍선"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Leader_GainSupport_MessageTextId"
msgid "내 편이 많을수록 나에게 좋을 거야."
msgstr "Im więcej sojuszników, tym lepiej dla mnie."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Leader_ImprovePersuasion_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "희망 상태의 리더 성향 설득력 향상 말풍선"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Leader_ImprovePersuasion_MessageTextId"
msgid "말하기 연습을 열심히 해야 해."
msgstr "Muszę częściej ćwiczyć przemawianie."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Leader_JoinJob_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "리더 성향 캐릭터의 취업 직후 역량 입증 의지 머리 위 말풍선"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Leader_JoinJob_MessageTextId"
msgid "내가 해낼 수 있다는 걸 보여줄 시간이야."
msgstr "Czas pokazać, że umiem to zrobić."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Leader_LeftJob_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "리더 성향 캐릭터가 직장을 떠난 직후 더 큰 영향력을 발휘할 곳을 찾으려 할 때의 머리 위 말풍선"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Leader_LeftJob_MessageTextId"
msgid "내 능력을 필요로 하는 곳에서 더 큰 영향력을 발휘해야겠어."
msgstr "Muszę wywrzeć większy wpływ tam, gdzie moje umiejętności są potrzebne."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Leader_Memoir_SpeechBubble_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "리더 특성 회고 말풍선 대사"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Leader_Memoir_SpeechBubble_MessageTextId"
msgid "더 나은 리더가 되기 위한 반성의 시간이었어."
msgstr "To był czas na zastanowienie się nad tym, jak zostać lepszym liderem."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Leader_Muscular_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "리더 특성 캐릭터의 근력 운동 중 자신과 주변 보호 의지 머리 위 말풍선"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Leader_Muscular_MessageTextId"
msgid "나와 주변을 지키기 위해서는 운동을 해야 해."
msgstr "Muszę ćwiczyć, aby chronić siebie i innych."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Leader_Muscular_Preference_Dislike_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "리더 성향 캐릭터의 비선호 근력 운동 중 강해지고 싶다는 머리 위 말풍선"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Leader_Muscular_Preference_Dislike_MessageTextId"
msgid "근력 운동은 별로지만 강해지고 싶어."
msgstr "Nie lubię treningu siłowego, ale chcę mieć większą siłę."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Leader_PointOutChild_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "리더 성향의 아이 지적 말풍선"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Leader_PointOutChild_MessageTextId"
msgid "다정하게 말해봤자 와닿지 않을 거야."
msgstr "Nieważne, jak słodkie są słowa, nie docierają."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Leader_PrepareSpeech_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "리더 성향 캐릭터의 연설 준비 중 연습 말풍선"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Leader_PrepareSpeech_MessageTextId"
msgid "열심히 연습해야 해."
msgstr "Chcę ciężko ćwiczyć."

