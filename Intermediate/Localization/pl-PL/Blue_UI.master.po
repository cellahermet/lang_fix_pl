msgctxt "ST_BuildPreset,BuildPreset_RedCity_Business_PhotoStudio_02_DisplayNameTextId"
msgid "크로마키 룸"
msgstr "Zielony pokój"

#. Key:	BuildPreset_RedCity_Business_PhotoStudio_03_DescriptionTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
#. InfoMetaData:	"DevComment" : "건축 프리셋 선택 UI의 레드시티 상업 포토 스튜디오(코인 세탁소 콘셉트) 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
msgctxt "ST_BuildPreset,BuildPreset_RedCity_Business_PhotoStudio_03_DescriptionTextId"
msgid "레트로하고 독특한 감성으로 당신의 매력을 한층 더 돋보이게 하는 코인 세탁소 컨셉의 포토 스튜디오입니다."
msgstr "Wyjątkowe studio fotograficzne w tematyce pralni na monety, które podkreśli twój styl zabawną atmosferą."

#. Key:	BuildPreset_RedCity_Business_PhotoStudio_03_DisplayNameTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
#. InfoMetaData:	"DevComment" : "건축 모드 부지 프리셋 목록·툴팁·검색 노출용 블리스베이 비즈니스 포토 스튜디오 03 표시명 (글로서리 포함)"
