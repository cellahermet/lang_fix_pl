msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Lazy_MassageChair_MessageTextId"
msgid "안마의자에서 쉬면 편안할 거야."
msgstr "Czuję relaksację, odpoczywając na fotelu do masażu."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Lazy_Nap_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "게으름 특성 낮잠 행동 시 말풍선 문구"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Lazy_Nap_MessageTextId"
msgid "잠시 휴식 시간이 필요해."
msgstr "Potrzebuję krótkiej przerwy."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Lazy_PlayComputerGame_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "게으름 특성 희망 '컴퓨터 게임하고 싶어' 말풍선 텍스트"
