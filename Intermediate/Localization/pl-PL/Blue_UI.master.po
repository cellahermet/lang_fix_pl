#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
msgctxt "ST_BuildPreset,BuildPreset_Gangnam_Residence_Free02_01_DisplayNameTextId"
msgid "클래식 스타일 쓰리룸"
msgstr "Klasyczny dom trzypokojowy"

#. Key:	BuildPreset_Gangnam_Residence_Free02_02_DescriptionTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
#. InfoMetaData:	"DevComment" : "건축 프리셋 목록의 강남 주거 3룸 프리셋 소개문"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
msgctxt "ST_BuildPreset,BuildPreset_Gangnam_Residence_Free02_02_DescriptionTextId"
msgid "실용적인 구조와 붉은 색감이 조화를 이루어 아늑하고 따뜻한 분위기가 느껴지는 쓰리룸입니다.\r\n3인 가구에게 추천합니다."
msgstr "Praktyczny dom trzypokojowy w ciepłych odcieniach czerwieni, które tworzą przytulną i zachęcającą atmosferę.\r\nPolecany dla rodzin 3-osobowych."

#. Key:	BuildPreset_Gangnam_Residence_Free02_02_DisplayNameTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
