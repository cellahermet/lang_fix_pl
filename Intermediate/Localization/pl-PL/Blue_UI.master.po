#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Lazy_QuitJob_MessageTextId"
msgid "퇴사하면 마음이 한결 가벼워질 거야."
msgstr "Zrelaksuję się po odejściu z pracy."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Lazy_SitRest_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "게으름 특성의 앉아 쉬기 행동 말풍선"
