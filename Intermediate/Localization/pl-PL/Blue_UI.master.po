#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Buff_NewYear_Shout_MessageTextId"
msgid "해피 뉴 이어!!"
msgstr "Szczęśliwego Nowego Roku!!"

