msgid "모던 내추럴 스타일 빌라"
msgstr "Nowoczesna naturalna willa"

#. Key:	BuildPreset_Gangnam_Residence_SkyBD_01_DescriptionTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
#. InfoMetaData:	"DevComment" : "강남 거주지 스카이빌딩 01 건축 프리셋 설명"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
msgctxt "ST_BuildPreset,BuildPreset_Gangnam_Residence_SkyBD_01_DescriptionTextId"
msgid "찬란한 도시와 함께 여유로운 삶을 즐길 수 있는 공간으로, 넓은 정원과 프라이빗 풀이 고급스러운 펜트하우스입니다.\r\n5인 가구에게 추천합니다."
msgstr "Luksusowy penthouse z przestronnym ogrodem i prywatnym basenem, które zapewniają schronienie od miejskiego zgiełku.\r\nPolecany dla rodzin 5-osobowych."

#. Key:	BuildPreset_Gangnam_Residence_SkyBD_01_DisplayNameTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
#. InfoMetaData:	"DevComment" : "건축 프리셋 UI에 표시되는 강남 레지던스 스카이 펜트하우스 이름"
#. InfoMetaData:	"IsTranslatable" : "1"
