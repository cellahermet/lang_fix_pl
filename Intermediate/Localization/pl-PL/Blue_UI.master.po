msgid "건강히 잘 지내는지 안부가 궁금해."
msgstr "Ciekawe, czy ma się dobrze."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Cooperator_PostFakeInfo_MessageTextId
