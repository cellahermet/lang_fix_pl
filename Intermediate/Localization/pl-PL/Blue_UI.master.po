msgstr "Czas wybrać swoją karierę"

#. Key:	Message_JobInducement_Desc_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "직업 권유 알림의 캣톡 본문 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_JobInducement_Desc_Text"
msgid "<CatTalk_Title>취업을 해 보면 어떨까냥?</>\r\n직업은 단순한 생계유지 수단이 아니다냥. 일을 하며 보람을 맛보게 하라냥!\r\n<img id=\"Bullet\"/><CatTalk_List>다양한 직업을 통해 자신의 가치를 발견할 수 있다냥.</>\r\n<img id=\"Bullet\"/><CatTalk_List>스마트폰</><img id=\"Phone\" width=\"22\" height=\"22\"/><CatTalk_List>의 JOB 앱을 통해 새로운 직장을 찾아보라냥!</>"
msgstr "<CatTalk_Title>Co powiesz na znalezienie pracy?</>\r\nPraca to nie tylko pieniądze, miau. Znajdziesz w niej także sens i radość, miau!\r\n<img id=\"Bullet\"/><CatTalk_List>Odblokuj swój potencjał, sprawdzając różne ścieżki kariery.</>\r\n<img id=\"Bullet\"/><CatTalk_List>Użyj aplikacji PRACA na smartfonie</><img id=\"Phone\" width=\"22\" height=\"22\"/><CatTalk_List>, aby znaleźć nową pracę, miau!</>"

#. Key:	Message_JobInducement_Link_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "직업 권유 알림 메시지의 스마트폰 메시지함 이동 링크 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_Message.ST_Message
msgctxt "ST_Message,Message_JobInducement_Link_Text"
msgid "스마트폰 열기"
msgstr "Użyj smartfona"

#. Key:	Message_JobInducement_Title_Text
#. SourceLocation:	/Game/Data/String/UI/ST_Message.ST_Message
#. InfoMetaData:	"DevComment" : "직업 선택 유도 캣톡 알림 제목 (글로서리 포함)"
