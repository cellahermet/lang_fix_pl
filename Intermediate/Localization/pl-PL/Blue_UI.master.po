msgctxt "ST_BuildPreset,BuildPreset_Architecture_Residence_Area01_19_DisplayNameTextId"
msgid "트래디셔널 스타일 주택"
msgstr "Tradycyjny dom"

#. Key:	BuildPreset_Architecture_Residence_Area01_20_DescriptionTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
#. InfoMetaData:	"DevComment" : "건축 프리셋 주택 상세 설명"
