#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Lazy_EatSimpleMeal_MessageTextId"
msgid "귀찮게 요리하는 것보다 시켜 먹는 게 훨씬 편할 거야."
msgstr "Łatwiej będzie coś zamówić niż gotować."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Lazy_MassageChair_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
