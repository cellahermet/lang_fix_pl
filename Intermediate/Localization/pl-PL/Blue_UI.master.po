msgctxt "ST_BuildPreset,BuildPreset_Gangnam_Residence_SkyBD_01_DisplayNameTextId"
msgid "엘레강트 스카이 펜트하우스"
msgstr "Elegancki penthouse"

#. Key:	BuildPreset_Gangnam_Residence_SkyBD_02_DescriptionTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
#. InfoMetaData:	"DevComment" : "건축 모드 기본 부지 프리셋(강남 레지던스 SkyBD_02) 툴팁 설명문"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
msgctxt "ST_BuildPreset,BuildPreset_Gangnam_Residence_SkyBD_02_DescriptionTextId"
msgid "넉넉한 공간과 절제된 아름다움이 돋보이는 현대적인 인테리어의 펜트하우스입니다.\r\n아이가 있는 5인 가구에게 추천합니다."
msgstr "Nowoczesny i przestronny penthouse w minimalistycznym stylu, idealny dla rodzin z dziećmi.\r\nPolecany dla rodzin 5-osobowych z dziećmi."

#. Key:	BuildPreset_Gangnam_Residence_SkyBD_02_DisplayNameTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
#. InfoMetaData:	"DevComment" : "강남 주거지 스카이 빌딩 02 건축 프리셋 UI 표시명 (글로서리 포함)"
