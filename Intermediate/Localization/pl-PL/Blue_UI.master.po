#: /Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
msgctxt "ST_BuildPreset,BuildPreset_Gangnam_Residence_DowonVilla_04_DescriptionTextId"
msgid "부드러운 핑크빛 감성이 돋보이는 아늑한 1인 주택입니다. 작은 공간에서도 따뜻하고 사랑스러운 분위기를 느껴보세요."
msgstr "Przytulny jednoosobowy dom w odcieniach różu. Ta niewielka przestrzeń tworzy ciepłą i uroczą atmosferę."

#. Key:	BuildPreset_Gangnam_Residence_DowonVilla_04_DisplayNameTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
