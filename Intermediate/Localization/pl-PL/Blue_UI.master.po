msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Lazy_DozenSit_MessageTextId"
msgid "잠시 눈을 붙이면 좋겠어."
msgstr "Chcę uciąć szybką drzemkę."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Lazy_EatSimpleMeal_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
#. InfoMetaData:	"DevComment" : "게으른 특성 간편식 희망 진행 말풍선"
