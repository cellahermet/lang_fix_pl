#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Trait_Cooperator_ShowerSing_SpeechBubble_MessageTextId"
msgid "이 노래, 다음에 다 같이 합창하면 좋겠어."
msgstr "Byłoby super, gdybyśmy następnym razem zaśpiewali razem."

#. Key:	SpeechBubble_SpeechBubbleData_1_Trait_Cooperator_StartFight_MessageTextId
#. SourceLocation:	/Game/Data/String/UI/ST_SpeechBubble.ST_SpeechBubble
