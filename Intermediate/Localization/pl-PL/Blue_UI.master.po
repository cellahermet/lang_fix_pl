msgid "지하철 컨셉 룸"
msgstr "Pokój w stylu wagonu metra"

#. Key:	BuildPreset_Gangnam_BusinessSite1_01_DescriptionTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
#. InfoMetaData:	"DevComment" : "강남 비즈니스 부지 1 기본 건축 프리셋 소개문"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
msgctxt "ST_BuildPreset,BuildPreset_Gangnam_BusinessSite1_01_DescriptionTextId"
msgid "따뜻한 붉은 벽돌과 크림색 차양이 어우러진 클래식한 꽃집입니다. 도심 속에 숨은 작은 정원처럼, 이곳에서는 꽃들의 색과 향이 더욱 또렷하게 느껴집니다."
msgstr "Klasyczna kwiaciarnia, która łączy ciepłe czerwone cegły z kremowymi markizami. Kolory i zapachy kwiatów wydają się tu jeszcze bardziej żywe, jak mały ogród ukryty w mieście."

#. Key:	BuildPreset_Gangnam_BusinessSite1_01_DisplayNameTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
#. InfoMetaData:	"DevComment" : "강남 상업 부지 1 기본 건축 프리셋명"
