#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
msgctxt "ST_BuildPreset,BuildPreset_Gangnam_Residence_SkyBD_02_DisplayNameTextId"
msgid "모던 럭셔리 펜트하우스"
msgstr "Nowoczesny luksusowy penthouse"

#. Key:	BuildPreset_inzoiEnv_AssetReview_Interior_01_DescriptionTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
#. InfoMetaData:	"DevComment" : "건축 모드 프리셋 목록/툴팁에 표시되는 지중해 스타일 2층 주택 프리셋 설명"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
msgctxt "ST_BuildPreset,BuildPreset_inzoiEnv_AssetReview_Interior_01_DescriptionTextId"
msgid "우아한 인테리어와 넓은 분리형 공간으로 여유로운 분위기가 느껴지는 주택입니다.\r\n아이가 있는 6인 가구에게 추천합니다."
msgstr "Dom z eleganckimi wnętrzami i przestrzenią podzieloną na obszary tworzące relaksującą atmosferę.\r\nPolecany dla rodzin 6-osobowych z dziećmi."

#. Key:	BuildPreset_inzoiEnv_AssetReview_Interior_01_DisplayNameTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
#. InfoMetaData:	"DevComment" : "건축 모드 프리셋 목록/툴팁에 표시되는 주택 프리셋명"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
msgctxt "ST_BuildPreset,BuildPreset_inzoiEnv_AssetReview_Interior_01_DisplayNameTextId"
msgid "지중해 스타일 2층 주택"
msgstr "Dwupiętrowy dom w stylu śródziemnomorskim"

#. Key:	BuildPreset_inzoiEnv_AssetReview_Interior_02_DescriptionTextId
#. SourceLocation:	/Game/Data/String/UI/ST_BuildPreset.ST_BuildPreset
#. InfoMetaData:	"DevComment" : "건축 모드 프리셋 목록/툴팁에 표시되는 주택 프리셋 설명"
#. InfoMetaData:	"IsTranslatable" : "1"
