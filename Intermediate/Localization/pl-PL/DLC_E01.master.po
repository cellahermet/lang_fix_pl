msgid "범고래 스티커"
msgstr "Naklejka z orką"

#. Key:	Object_E01_Sticker01_v01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "상어 스티커 장식 오브젝트 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Sticker01_v01_DescriptionTextId"
msgid "날렵한 몸집과 날카로운 이빨로 바다의 긴장감을 전하는 상어 스티커입니다."
msgstr "Naklejka ze stanowiącym postrach mórz rekinem o opływowym ciele z ostrymi zębami."

#. Key:	Object_E01_Sticker01_v01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "벽 장식용 스티커 오브젝트 이름 (글로서리 포함)"
