msgid "스트라이프 비치타올"
msgstr "Ręcznik plażowy w pasy"

#. Key:	Object_E01_Beanbag01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 배치 모드 빈백 소파 오브젝트 설명"
