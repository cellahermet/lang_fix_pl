msgstr "Fotel wypoczynkowy łączący ramę w głębokim odcieniu z rattanem, tworząc przytulną i wygodną całość."

#. Key:	Object_E01_Chair01_v05_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "인벤토리/오브젝트 UI에 표시되는 1인용 의자 이름 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Chair01_v05_DisplayNameTextId"
msgid "클래식 라탄 라운지 의자"
msgstr "Klasyczny rattanowy fotel wypoczynkowy"

#. Key:	Object_E01_Chair01_v06_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 가구 카탈로그용 1인 의자 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
