#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Sticker01_v03_DisplayNameTextId"
msgid "문어 스티커"
msgstr "Naklejka z ośmiornicą"

#. Key:	Object_E01_Sticker01_v04_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 벽면 스티커 장식 아이템 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Sticker01_v04_DescriptionTextId"
msgid "바닷속을 미끄러지듯 날아다니는 모습이 인상적인 가오리 스티커입니다."
msgstr "Naklejka z płaszczką elegancko sunącą przez ocean."

#. Key:	Object_E01_Sticker01_v04_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 스티커 벽 장식 이름 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Sticker01_v04_DisplayNameTextId"
msgid "가오리 스티커"
msgstr "Naklejka z płaszczką"

#. Key:	Object_E01_Sunbed01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 야외 공간 선베드 가구 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Sunbed01_DescriptionTextId"
msgid "라탄 소재와 베이지 쿠션이 어우러진 여유로운 선베드입니다."
msgstr "Duży leżak z rattanu z beżowymi poduszkami."

#. Key:	Object_E01_Sunbed01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "야외 공간 선베드 가구명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Sunbed01_DisplayNameTextId"
msgid "라탄 선베드"
msgstr "Rattanowy leżak"

#. Key:	Object_E01_Sunbed01_v01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 야외 공간 선베드 가구 설명"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Sunbed01_v01_DescriptionTextId"
msgid "탄탄한 등받이와 부드러운 텍스처로 편안함을 더한 휴식용 선베드입니다."
msgstr "Miękki leżak z wygodnym, wytrzymałym oparciem."

#. Key:	Object_E01_Sunbed01_v01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 야외 공간 선베드 가구명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Sunbed01_v01_DisplayNameTextId"
msgid "릴랙스 선베드"
msgstr "Leżak relaksacyjny"

#. Key:	Object_E01_Sunbed01_v02_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "오브젝트 인벤토리/정보창 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Sunbed01_v02_DescriptionTextId"
msgid "자연스러운 나뭇결과 베이지 톤의 쿠션이 어우러진, 햇살 아래 편안한 휴식을 위한 내추럴 스타일의 선베드입니다."
msgstr "Leżak w naturalnym stylu do opalania. Ma naturalne słoje drewna i beżowe poduszki."

#. Key:	Object_E01_Sunbed01_v02_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 배치 모드 선베드 이름 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Sunbed01_v02_DisplayNameTextId"
msgid "내추럴 우드 선베드"
msgstr "Leżak z naturalnego drewna"

#. Key:	Object_E01_Table02_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 카탈로그용 책상 아이템 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Table02_DescriptionTextId"
msgid "라탄 서랍과 사이드 패널이 포인트인, 깔끔하고 실용적인 디자인의 책상입니다."
msgstr "Biurko o schludnym, funkcjonalnym designie z rattanowymi szufladami i bocznymi panelami."

#. Key:	Object_E01_Table02_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 배치/구매 UI에 노출되는 책상 오브젝트명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Table02_DisplayNameTextId"
msgid "라탄 서랍형 사무 책상"
msgstr "Biurko z rattanowymi szufladami"

#. Key:	Object_E01_Table02_v01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 배치 모드 책상 아이템 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Table02_v01_DescriptionTextId"
msgid "전면 라탄 서랍과 장식적인 다리 구조가 조화를 이루는 감각적인 디자인의 책상입니다."
msgstr "Stylowe biurko z rattanową szufladą z przodu i ozdobnymi nóżkami."

#. Key:	Object_E01_Table02_v01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 책상 가구명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Table02_v01_DisplayNameTextId"
msgid "라탄 서랍 디테일 책상"
msgstr "Biurko z rattanową szufladą"

#. Key:	Object_E01_Table03_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 식당 테이블 가구 설명"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Table03_DescriptionTextId"
msgid "길게 이어진 목재 패널이 조화를 이루는 식탁입니다. 넓은 상판이 주는 여유로움이 일상에 편안함을 더해줍니다."
msgstr "Stół do jadalni wykonany z długich paneli drewnianych. Szeroka powierzchnia wprowadza komfort i przestrzeń do codziennego życia."

#. Key:	Object_E01_Table03_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 식당 테이블 가구명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Table03_DisplayNameTextId"
msgid "패치 우드 롱 식탁"
msgstr "Długi drewniany stół do jadalni"

#. Key:	Object_E01_Table03_v01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 구매/배치 모드 식탁 아이템 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Table03_v01_DescriptionTextId"
msgid "상판에 바다결 무늬가 들어간 독특한 식탁입니다. 휴양지나 바닷가 공간에 잘 어울리는 포인트 가구입니다."
msgstr "Unikatowy stół do jadalni ze wzorem na powierzchni. Ozdobny mebel, który wspaniale pasuje do kurortu czy przestrzeni nadbrzeżnych."

#. Key:	Object_E01_Table03_v01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "식당 가구 카탈로그의 식탁 이름 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Table03_v01_DisplayNameTextId"
msgid "바다무늬 식탁"
msgstr "Stół do jadalni z oceanicznym wzorem"

#. Key:	Object_E01_Toilet03_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 야외용 공중 화장실 가구 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Toilet03_DescriptionTextId"
msgid "슬레이트 지붕과 간단한 목재 구조로 만들어진, 야외에 임시 설치하기 적합한 공중 화장실입니다."
msgstr "Łazienka do tymczasowe użytku na podwórku, z pochylonym daszkiem i prostą konstrukcją z drewna."

#. Key:	Object_E01_Toilet03_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "야외 배치용 간이 공중 화장실 오브젝트 이름 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
