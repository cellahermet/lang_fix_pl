#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Bed01_v03_DisplayNameTextId"
msgid "빈티지 메탈 프레임 퀸 사이즈 침대"
msgstr "Łóżko dwuosobowe z metalową ramą w stylu vintage"

#. Key:	Object_E01_Bed02_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 배치 카탈로그의 침대 아이템 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Bed02_DescriptionTextId"
msgid "원목 프레임과 담백한 디테일이 조화를 이루는 따뜻한 분위기의 침대입니다."
msgstr "Pojedyncze łóżko z solidną drewnianą ramą i prostymi detalami, które wprowadza ciepłą atmosferę."

#. Key:	Object_E01_Bed02_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 배치 모드 침대 카테고리 오브젝트명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Bed02_DisplayNameTextId"
msgid "내추럴 우드 싱글 침대"
msgstr "Pojedyncze łóżko z naturalnego drewna"

#. Key:	Object_E01_Bed02_v01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 배치 카탈로그의 침대 아이템 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Bed02_v01_DescriptionTextId"
msgid "정갈한 침구와 라탄 프레임이 어우러져 밝고 산뜻한 분위기를 연출하는 침대입니다."
msgstr "Łóżko z czystym posłaniem i rattanową ramą, wprowadzające świeżość i światło do pomieszczenia."

#. Key:	Object_E01_Bed02_v01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 가구 카탈로그에 표시되는 싱글 침대 이름 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Bed02_v01_DisplayNameTextId"
msgid "클래식 라탄 싱글 침대"
msgstr "Klasyczne rattanowe jednoosobowe łóżko"

#. Key:	Object_E01_Bench01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 야외 공간 벤치 가구 설명"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Bench01_DescriptionTextId"
msgid "바랜 나무결 위에 앉으면 오래된 공원의 오후처럼 느릿한 시간이 흘러갑니다. 묵묵히 자리를 지켜온 쉼의 자리를 선사합니다."
msgstr "Usiądź na wysłużonym drewnie i poczuj, jak czas zwalnia niczym w parku w spokojne popołudnie. Idealne miejsce na odpoczynek."

#. Key:	Object_E01_Bench01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 야외 공간 벤치 가구명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Bench01_DisplayNameTextId"
msgid "빈티지 우드 벤치"
msgstr "Drewniana ławka w stylu vintage"

#. Key:	Object_E01_Bench01_v01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 배치 카탈로그의 빈티지 스타일 벤치 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Bench01_v01_DescriptionTextId"
msgid "다양한 색감의 나무 패널이 조화롭게 어우러진, 거칠면서도 감성적인 분위기를 자아내는 빈티지 스타일 벤치입니다."
msgstr "Ławka w stylu vintage łącząca kolorowe panele z drewna, tworząc surową, emocjonalną harmonię."

#. Key:	Object_E01_Bench01_v01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 벤치 오브젝트 이름 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Bench01_v01_DisplayNameTextId"
msgid "패치 우드 벤치"
msgstr "Drewniana kolorowa ławka"

#. Key:	Object_E01_Bench01_v02_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 배치 모드 야외 벤치 아이템 설명"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Bench01_v02_DescriptionTextId"
msgid "시간에 스며든 듯 바랜 컬러 패널이 조화를 이루는 벤치입니다. 거칠면서도 부드러운 분위기가 공간에 자연스러운 멋을 더해줍니다."
msgstr "Ławka z wyblakłymi panelami stanowiąca wyjątkową, urokliwą ozdobę."

#. Key:	Object_E01_Bench01_v02_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 배치 모드 야외 벤치 아이템 이름 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Bench01_v02_DisplayNameTextId"
msgid "페이드 패치 우드 벤치"
msgstr "Wyblakła drewniana ławka"

#. Key:	Object_E01_BicycleRack01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 소형 야외 장식 자전거 거치대 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_BicycleRack01_DescriptionTextId"
msgid "페인트가 벗겨진 철제 자전거 거치대입니다.\r\n오래된 거리나 방치된 공터에 리얼리티를 더해줍니다."
msgstr "Metalowy stojak na rowery ze starą farbą. Doda odrobiny realizmu starym ulicom lub porzuconym działkom."

#. Key:	Object_E01_BicycleRack01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 소형 야외 오브젝트 이름"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_BicycleRack01_DisplayNameTextId"
msgid "낡은 자전거 거치대"
msgstr "Stary stojak na rowery"

#. Key:	Object_E01_BigTent01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "야외 배치용 천막 오브젝트 설명"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_BigTent01_DescriptionTextId"
msgid "여러 계절을 견뎌낸 흔적이 고스란히 담긴 천막입니다. 투박하지만 든든한 그늘을 제공합니다."
msgstr "Wysłużona płachta nosząca ślady wielokrotnego używania, zapewniająca niezawodne zacienienie."

#. Key:	Object_E01_BigTent01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "야외 배치용 천막 오브젝트명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_BigTent01_DisplayNameTextId"
msgid "낡은 야외용 천막"
msgstr "Zużyta płachta"

#. Key:	Object_E01_Blind04_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 배치 모드 블라인드 카테고리 아이템 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Blind04_DescriptionTextId"
msgid "대나무 소재로 구성된 접이식 블라인드입니다. 햇빛을 가리거나 공간을 분리하는 데 사용됩니다."
msgstr "Składane rolety bambusowe. Mogą służyć do blokowania światła lub dzielenia przestrzeni."

#. Key:	Object_E01_Blind04_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축/구매 카탈로그의 블라인드 가구명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Blind04_DisplayNameTextId"
msgid "대나무 블라인드"
msgstr "Rolety bambusowe"

#. Key:	Object_E01_BoatTrailer01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "야외 대형 장식용 보트 운반 트레일러 설명"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_BoatTrailer01_DescriptionTextId"
msgid "천막으로 덮인 보트를 운반하는 이동용 트레일러입니다. 주차된 상태로 활용됩니다."
msgstr "Przyczepa do transportowania łodzi z daszkiem. Zwykle stoi w pozycji zaparkowanej."

#. Key:	Object_E01_BoatTrailer01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 대형 야외 장식용 보트 트레일러 이름"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_BoatTrailer01_DisplayNameTextId"
msgid "보트 트레일러"
msgstr "Przyczepa na łódź"

#. Key:	Object_E01_Bookcase01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 카탈로그용 책장 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Bookcase01_DescriptionTextId"
msgid "부드러운 아치형 상단과 라탄 디테일이 어우러져 공간에 따뜻한 포인트를 더해주는 책장입니다."
msgstr "Regał z książkami z delikatnie łukowatą górą i rattanowymi detalami, które wprowadzają ciepło do pomieszczenia."

#. Key:	Object_E01_Bookcase01_DisplayNameTextId
