msgstr "Stoisko z produktami dla kotów"

#. Key:	Object_E01_CatStatue01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 배치 모드 장식용 고양이 석상 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_CatStatue01_DescriptionTextId"
msgid "고요한 눈빛 속에 고양이의 신비로움을 담아낸 고양이 석상입니다."
msgstr "Posąg kota, którego spokojne spojrzenie uosabia kocią tajemniczość."

#. Key:	Object_E01_CatStatue01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 배치 모드 장식용 고양이 석상 이름 (글로서리 포함)"
