#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Bed01_v01_DisplayNameTextId"
msgid "라운드 쿠션 퀸 사이즈 침대"
msgstr "Łóżko dwuosobowe z okrągłą poduchą"

#. Key:	Object_E01_Bed01_v03_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 카탈로그 침대 아이템 설명"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Bed01_v03_DescriptionTextId"
msgid "메탈과 우드가 조화를 이룬 구조적 디자인의 침대입니다."
msgstr "Łóżko łączące metal z drewnem dla zrównoważonego stylu."

#. Key:	Object_E01_Bed01_v03_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 배치 모드 침대 카테고리용 오브젝트 이름 (글로서리 포함)"
