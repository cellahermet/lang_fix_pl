msgid "<CatTalk_Bold>차하야의 다채로운 공간을 함께 살펴봅시다!</>\r\n\r\n<img id=\"Tutorial_DLC_Cahaya_000\" width=\"600\" height=\"396\"/>\r\n<CatTalk_Bold>상세 안내</>\r\n<img id=\"Space\"/>\r\n<img id=\"Pink1\" width=\"24\" height=\"24\"/> 낚시 상점\r\n<img id=\"Pink2\" width=\"24\" height=\"24\"/> 농업 상점\r\n<img id=\"Pink3\" width=\"24\" height=\"24\"/> 나나 마트\r\n<img id=\"Pink4\" width=\"24\" height=\"24\"/> 납품점\r\n<img id=\"Pink5\" width=\"24\" height=\"24\"/> 미아타라 사원 기념품 샵\r\n<img id=\"PinkT\" width=\"24\" height=\"24\"/> 오션 게이트\r\n<img id=\"Orange6\" width=\"24\" height=\"24\"/> 나나고렝\r\n<img id=\"Orange7\" width=\"24\" height=\"24\"/> 선 웨이브 바 & 카페\r\n<img id=\"Orange8\" width=\"24\" height=\"24\"/> 카페 카유\r\n<img id=\"Yellow9\" width=\"24\" height=\"24\"/> 가든 빌라\r\n<img id=\"Yellow10\" width=\"24\" height=\"24\"/> 오션뷰 빌라\r\n<img id=\"Yellow11\" width=\"24\" height=\"24\"/> 워터 빌라 웰컴 하우스\r\n<img id=\"Green12\" width=\"24\" height=\"24\"/> 낚시터\r\n<img id=\"Green13\" width=\"24\" height=\"24\"/> 팔모라 스테이\r\n<img id=\"Green14\" width=\"24\" height=\"24\"/> 농구장\r\n<img id=\"Green15\" width=\"24\" height=\"24\"/> 웨딩 스튜디오\r\n<img id=\"Green16\" width=\"24\" height=\"24\"/> 바랏 해변\r\n<img id=\"Green17\" width=\"24\" height=\"24\"/> 수아라 달람 명상센터"
msgstr "<CatTalk_Bold>Odkryj wspaniałe miejsca na Cahayi!</>\r\n\r\n<img id=\"Tutorial_DLC_Cahaya_000\" width=\"600\" height=\"396\"/>\r\n<CatTalk_Bold>Szczegóły</>\r\n<img id=\"Space\"/>\r\n<img id=\"Pink1\" width=\"24\" height=\"24\"/>Sklep z akcesoriami wędkarskimi\r\n<img id=\"Pink2\" width=\"24\" height=\"24\"/>Sklep z zaopatrzeniem rolniczym\r\n<img id=\"Pink3\" width=\"24\" height=\"24\"/>Nana Mart\r\n<img id=\"Pink4\" width=\"24\" height=\"24\"/>Komis\r\n<img id=\"Pink5\" width=\"24\" height=\"24\"/>Sklep z upominkami w Świątyni Miatara\r\n<img id=\"PinkT\" width=\"24\" height=\"24\"/>Brama Oceanu\r\n<img id=\"Orange6\" width=\"24\" height=\"24\"/>Nana Goreng\r\n<img id=\"Orange7\" width=\"24\" height=\"24\"/>Bar i kawiarnia Sunwave\r\n<img id=\"Orange8\" width=\"24\" height=\"24\"/>Kawiarnia Kayu\r\n<img id=\"Yellow9\" width=\"24\" height=\"24\"/>Garden Villa\r\n<img id=\"Yellow10\" width=\"24\" height=\"24\"/>Ocean View Villa\r\n<img id=\"Yellow11\" width=\"24\" height=\"24\"/>Dom gościnny Water Villa\r\n<img id=\"Green12\" width=\"24\" height=\"24\"/>Łowisko\r\n<img id=\"Green13\" width=\"24\" height=\"24\"/>Palmora Stay\r\n<img id=\"Green14\" width=\"24\" height=\"24\"/>Boisko do koszykówki\r\n<img id=\"Green15\" width=\"24\" height=\"24\"/>Studio ślubne\r\n<img id=\"Green16\" width=\"24\" height=\"24\"/>Plaża Barat\r\n<img id=\"Green17\" width=\"24\" height=\"24\"/>Centrum medytacji Suara Dalam"

