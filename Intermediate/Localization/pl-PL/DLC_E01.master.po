msgid "간식 선반 진열대"
msgstr "Stoisko wystawowe z przekąskami"

#. Key:	Object_E01_SnackShelf02_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "실내 가구 배치용 간식 진열대 설명 (글로서리 포함)"
