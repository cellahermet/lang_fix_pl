msgctxt "ST_Object,Object_E01_SquidSkewers01_DescriptionTextId"
msgid "한 입 물면 해물향이 가득 입안에 퍼지는 오징어 꼬치입니다."
msgstr "Szaszłyk z kałamarnicy. Każdy kęs aż tętni od aromatu owoców morza."

#. Key:	Object_E01_SquidSkewers01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
