#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Chair01_v02_DisplayNameTextId"
msgid "내추럴 라탄 라운지 의자"
msgstr "Fotel wypoczynkowy z naturalnego rattanu"

#. Key:	Object_E01_Chair01_v03_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 가구 카탈로그의 클래식 라탄 암체어 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Chair01_v03_DescriptionTextId"
msgid "곡선형 프레임과 라탄 등받이가 어우러져 고풍스러운 분위기를 자아내는 1인용 암체어입니다."
msgstr "Jednoosobowy fotel z zakrzywioną ramą i rattanowym oparciem o ponadczasowym uroku."

#. Key:	Object_E01_Chair01_v03_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 카탈로그에 노출되는 싱글 체어 이름 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Chair01_v03_DisplayNameTextId"
msgid "클래식 라탄 암체어"
msgstr "Klasyczny rattanowy fotel"

#. Key:	Object_E01_Chair01_v04_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 구매 UI의 패브릭 스툴 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
