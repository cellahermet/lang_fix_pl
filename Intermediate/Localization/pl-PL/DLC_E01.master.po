msgctxt "ST_BuildPreset,BuildPreset_Cahaya_Residence_NPCSite2_03_DisplayNameTextId"
msgid "고가형 주택"
msgstr "Drogi dom"

#. Key:	BuildPreset_Cahaya_Residence_NPCSite2_04_DescriptionTextId
#. SourceLocation:	/E01/Data/String/UI/ST_BuildPreset.ST_BuildPreset
#. InfoMetaData:	"DevComment" : "카하야 거주지 NPC 부지 2-04 기본 건축 프리셋 설명"
