msgctxt "ST_BuildPreset,BuildPreset_Cahaya_Residence_LocalHouse1_01_DisplayNameTextId"
msgid "저가형 주택"
msgstr "Niedrogi dom"

#. Key:	BuildPreset_Cahaya_Residence_LocalHouse1_02_DescriptionTextId
#. SourceLocation:	/E01/Data/String/UI/ST_BuildPreset.ST_BuildPreset
#. InfoMetaData:	"DevComment" : "건축 프리셋 목록용 주택 소개문"
