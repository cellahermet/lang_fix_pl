#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Buff.ST_Buff
msgctxt "ST_Buff,Buff_BuffDisplayInfo_Cahaya_Farmer_Request_PositiveAnswer_1_ReasonTextId"
msgid "[작업 중 부상으로 인해 발생] 너무 무리했나 봐요… 허리가 너무 뻐근합니다…"
msgstr "[Z powodu urazu podczas pracy] Wygląda na to, że przesadzasz z wysiłkiem. Masz bardzo sztywny kręgosłup."

#. Key:	Buff_BuffDisplayInfo_Cahaya_Farmer_Request_PositiveAnswer_2_DisplayTextId
