#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_PicnicTable01_DescriptionTextId"
msgid "긁힘과 변색이 그대로 남아 있는 피크닉 테이블입니다."
msgstr "Stół piknikowy poznaczony zadrapaniami i odbarwieniami."

#. Key:	Object_E01_PicnicTable01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "야외 공간 테이블 가구 이름 (글로서리 포함)"
