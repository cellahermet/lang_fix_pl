#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/UI/ST_BuildPreset.ST_BuildPreset
msgctxt "ST_BuildPreset,BuildPreset_Cahaya_Residence_LocalHouse1_01_DescriptionTextId"
msgid "추억이 담긴 물건들로 하나씩 채워가는 재미가 있는 실속 있는 저가형 주택입니다. 시작은 소박하지만, 그 끝은 분명 아름다울 거예요."
msgstr "Niedrogi dom, który możesz wypełnić bibelotami. Może i jest skromny, ale na pewno zmieni się w coś pięknego."

