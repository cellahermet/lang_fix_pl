#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Sticker01_v02_DisplayNameTextId"
msgid "해파리 스티커"
msgstr "Naklejka z meduzą"

#. Key:	Object_E01_Sticker01_v03_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 벽 장식 문어 스티커 설명"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Sticker01_v03_DescriptionTextId"
msgid "여러 개의 다리로 유쾌한 움직임을 자랑하는 문어 스티커입니다."
msgstr "Naklejka z ośmiornicą radośnie poruszającą swoimi wieloma odnóżami."

#. Key:	Object_E01_Sticker01_v03_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 벽 장식 스티커 이름"
