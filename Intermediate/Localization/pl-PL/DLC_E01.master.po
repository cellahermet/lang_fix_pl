msgid "특별한 고양이 스프레이"
msgstr "Specjalny spray wabiący koty"

#. Key:	Object_E01_CatShop01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "캣샵 소품·간식 진열 리어카형 가판대 오브젝트 설명"
