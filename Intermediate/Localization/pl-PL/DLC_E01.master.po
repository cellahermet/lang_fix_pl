msgid "포근한 쿠션과 라탄 소재의 조화가 매력적인 내추럴 감성의 1인용 의자입니다."
msgstr "Wygodny jednoosobowy fotel z pluszowymi poduszkami i rattanowymi materiałami."

#. Key:	Object_E01_Chair01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 가구(싱글 의자) 목록·검색·툴팁 노출명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Chair01_DisplayNameTextId"
msgid "라탄 쿠션 의자"
msgstr "Rattanowy fotel z poduszkami"

#. Key:	Object_E01_Chair01_v02_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 라탄 라운지 의자 가구 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
