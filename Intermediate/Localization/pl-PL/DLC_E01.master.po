msgstr "Wisząca roślina domowa z dwoma koszami rattanowymi, która tworzy ozdobny akcent zieleni."

#. Key:	Object_E01_CeilingPot01_v01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 배치용 천장 걸이 화분 이름 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_CeilingPot01_v01_DisplayNameTextId"
msgid "이단 라탄 천장 화분"
msgstr "Dwuwarstwowa wisząca donica rattanowa"

#. Key:	Object_E01_Chair01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 가구(싱글 의자) 툴팁 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
