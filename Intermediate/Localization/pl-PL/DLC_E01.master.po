#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_HouseholdBizDefaultSetup.ST_HouseholdBizDefaultSetup
msgctxt "ST_HouseholdBizDefaultSetup,HouseholdBizDefaultSetup_FlowerShop_Cahaya_Name"
msgid "아유 메카르 꽃집"
msgstr "Kwiaciarnia Ayumekar"

