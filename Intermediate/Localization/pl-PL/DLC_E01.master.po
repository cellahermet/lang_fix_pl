#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_PostCard01_DisplayNameTextId"
msgid "차하야 엽서"
msgstr "Pocztówka z Cahayi"

#. Key:	Object_E01_Poster01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "차하야 리조트 플레이 존 이벤트 일정 안내 포스터 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Poster01_DescriptionTextId"
msgid "차하야 리조트의 명물, 플레이 존의 안내문입니다. 다양한 이벤트의 개최 날짜와 시간이 적혀있습니다."
msgstr "Znak informujący o słynnej Strefie zabawy w Kurorcie Cahaya. Podaje daty i godziny różnych wydarzeń."

#. Key:	Object_E01_Poster01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "플레이존 장식용 안내 포스터 이름 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Poster01_DisplayNameTextId"
msgid "플레이존 안내문"
msgstr "Tablica Strefy zabawy"

#. Key:	Object_E01_Poster01_v01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "플레이 존 거북봇 레이스 안내 포스터 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Poster01_v01_DescriptionTextId"
msgid "차하야 리조트의 명물, 플레이 존의 거북봇 레이스 소개 포스터입니다. 거북봇 레이스의 개최 날짜와 시간이 적혀있습니다."
msgstr "Plakat przedstawiający słynne wyścigi żółwi w Strefie zabawy w Kurorcie Cahaya. Podaje daty i godziny wyścigów."

#. Key:	Object_E01_Poster01_v01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "플레이존 포스터 오브젝트 이름"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Poster01_v01_DisplayNameTextId"
msgid "거북이 포스터"
msgstr "Plakat z żółwiami"

#. Key:	Object_E01_Pot01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 장식용 화분 오브젝트 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Pot01_DescriptionTextId"
msgid "장식 문양이 새겨진 화분에서 섬세하게 뻗어 오른 잎야자가 공간에 싱그러움을 더해주는 장식용 화분입니다."
msgstr "Ozdobna palma w donicy z dekoracyjnymi rzeźbieniami, które wprowadzają świeży akcent do pomieszczenia."

#. Key:	Object_E01_Pot01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 장식용 화분 오브젝트 이름 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Pot01_DisplayNameTextId"
msgid "테라코타 잎야자 화분"
msgstr "Palma w donicy z terakoty"

#. Key:	Object_E01_Pot02_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 배치용 마른 가지 장식 화분 설명"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Pot02_DescriptionTextId"
msgid "길게 뻗은 마른 가지들이 투박한 토기 화병과 어우러져 자연스러운 멋을 전해주는 장식용 화분입니다."
msgstr "Roślina ozdobna o suchych, cienkich gałęziach w chropowatej wazie w ziemistym kolorze."

#. Key:	Object_E01_Pot02_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 오브젝트 상점에 표시되는 화분 이름 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Pot02_DisplayNameTextId"
msgid "마른 가지 장식 화분"
msgstr "Roślina ozdobna z suchymi gałęziami"

#. Key:	Object_E01_PreparedBananaCue01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "서비스벨 주문 후 손에 생성되어 먹는 음식 설명"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_PreparedBananaCue01_DescriptionTextId"
msgid "바삭하게 캐러멜라이징한 설탕이 겉을 감싸고, 속은 부드러운 바나나가 꽉 찬 나눠 먹을 수 있는 달콤한 디저트입니다."
msgstr "Słodki deser z miękkim bananem w środku i chrupiącym, skarmelizowanym cukrem na zewnątrz."

#. Key:	Object_E01_PreparedBananaCue01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "서비스벨 주문 후 손에 생성되어 먹는 음식 이름 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_PreparedBananaCue01_DisplayNameTextId"
msgid "바나나 큐"
msgstr "Banana Cue"

#. Key:	Object_E01_PreparedMangoRice01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "서비스벨 주문 후 손에 생성되어 먹는 음식 상세 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_PreparedMangoRice01_DescriptionTextId"
msgid "부드럽게 익힌 망고와 코코넛 향이 가득한 찹쌀밥이 어우러진 나눠 먹을 수 있는 달콤한 디저트입니다."
msgstr "Słodki deser z delikatnego mango i lepkiego ryżu o smaku kokosa."

#. Key:	Object_E01_PreparedMangoRice01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "서비스벨 주문 후 손에 생성되어 먹는 음식 이름 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_PreparedMangoRice01_DisplayNameTextId"
msgid "망고 찹쌀밥"
msgstr "Mango sticky rice"

#. Key:	Object_E01_RattanBasket01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 모드 장식용 라탄 바구니 아이템 설명"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_RattanBasket01_DescriptionTextId"
msgid "자연스러운 짜임과 양쪽 손잡이가 포인트가 되어 공간에 따뜻한 멋을 더해주는 장식용 바구니입니다."
msgstr "Przytulny rattanowy kosz o naturalnym splocie z podwójnymi rączkami."

#. Key:	Object_E01_RattanBasket01_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 장식용 라탄 바구니 오브젝트 이름 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_RattanBasket01_DisplayNameTextId"
msgid "라탄 손잡이 바구니"
msgstr "Rattanowy kosz z rączkami"

#. Key:	Object_E01_RattanBasket02_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 장식용 라탄 바구니 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_RattanBasket02_DescriptionTextId"
msgid "단단한 링 형태의 손잡이가 포인트가 되어 실내 어디에나 자연스럽게 어우러지는 장식용 바구니입니다."
msgstr "Ozdobny kosz z wytrzymałymi uchwytami w kształcie pierścieni, który naturalnie pasuje do każdego wnętrza."

#. Key:	Object_E01_RattanBasket02_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 장식용 라탄 바구니 오브젝트 이름 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_RattanBasket02_DisplayNameTextId"
msgid "라탄 링 핸들 바구니"
msgstr "Rattanowy kosz z uchwytami w kształcie pierścieni"

#. Key:	Object_E01_RattanBasket03_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 장식 카테고리의 양손잡이 라탄 바구니 오브젝트 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_RattanBasket03_DescriptionTextId"
msgid "균형 잡힌 형태와 양쪽 손잡이가 실용성과 장식을 겸하는 내추럴 무드의 장식용 바구니입니다."
msgstr "Wyważony kosz rattanowy z uchwytami po obu stronach, łączący praktyczność z urokiem."

#. Key:	Object_E01_RattanBasket03_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 장식 카테고리의 양손잡이 라탄 바구니 오브젝트명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_RattanBasket03_DisplayNameTextId"
msgid "라탄 투 핸들 바구니"
msgstr "Rattanowy kosz z dwoma uchwytami"

#. Key:	Object_E01_RattanBox01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "건축 모드 오브젝트 카탈로그에 표시되는 작은 라탄 바구니 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
