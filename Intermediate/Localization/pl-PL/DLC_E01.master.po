msgid "거북 봇 FRESHY 포스터"
msgstr "Plakat wyścigu żółwi z Freshym"

#. Key:	Object_E01_Frame04_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "벽걸이 장식용 거북 봇 레이스 포스터 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Frame04_DescriptionTextId"
msgid "거북 봇 레이스의 SPEEDY 포스터입니다.\r\n불가사리 친구와 함께하는 바닷속 스피드왕! 톡톡 튀는 에너지가 매력 포인트입니다."
msgstr "To plakat wyścigu żółwi ze Speedym.\r\nPodwodny struś pędziwiatr z przyjacielem rozgwiazdą! Jego urok bierze się z nieskończonej energii!"

#. Key:	Object_E01_Frame04_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "오브젝트 카탈로그에 표시되는 포스터 가구명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Frame04_DisplayNameTextId"
msgid "거북 봇 SPEEDY 포스터"
msgstr "Plakat wyścigu żółwi ze Speedym"

#. Key:	Object_E01_Frame05_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "벽걸이 장식용 거북 봇 ROCKY 포스터 설명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
msgctxt "ST_Object,Object_E01_Frame05_DescriptionTextId"
msgid "거북 봇 레이스의 ROCKY 포스터입니다.\r\n번뜩이는 눈빛과 왕관처럼 당당한 태도! 영리한 머리 회전으로 누구보다 영리하게 승부를 이끄는 전략가 거북이입니다."
msgstr "To plakat wyścigu żółwi z Rockym.\r\nOstre spojrzenie i dumna postawa! Rocky to strategiczny żółw, który prowadzi w wyścigu dzięki sprytowi."

#. Key:	Object_E01_Frame05_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "벽걸이 장식용 거북 봇 ROCKY 포스터 이름 (글로서리 포함)"
