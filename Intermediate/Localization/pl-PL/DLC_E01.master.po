#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Buff.ST_Buff
msgctxt "ST_Buff,Buff_BuffDisplayInfo_Buff_Stat_CoinLimit_Check_DisplayTextId"
msgid "(None) 일일 코인 교환 리미트 리셋용"
msgstr ""

#. Key:	Buff_BuffDisplayInfo_Buff_Stat_CoinLimit_Check_ReasonTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Buff.ST_Buff
#. InfoMetaData:	"DevComment" : "번역 대상 아님. (None) 마커는 원문 형태 그대로 유지 대상입니다."
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Buff.ST_Buff
