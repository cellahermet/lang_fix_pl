msgid "내추럴 라탄 프레임 퀸 사이즈 침대"
msgstr "Łóżko dwuosobowe z rattanową ramą"

#. Key:	Object_E01_Bed01_v01_DescriptionTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 배치 모드 침대 아이템 설명 (글로서리 포함)"
