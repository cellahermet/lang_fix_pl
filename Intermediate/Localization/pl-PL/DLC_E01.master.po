msgctxt "ST_Object,Object_E01_Frame06_DescriptionTextId"
msgid "거북 봇 레이스의 단체 포스터입니다.차하야 리조트의 귀여운 거북 봇 친구들!\r\n트랙 위를 누비는 사랑스러운 거북이들의 한 판 승부를 구경해보세요"
msgstr "Plakat grupowy wyścigów żółwi, na którym widać urocze żółwie z Kurortu Cahaya!\r\nPrzyjdź i obejrzyj zmagania tych uwielbianych zwierząt na torze."

#. Key:	Object_E01_Frame06_DisplayNameTextId
#. SourceLocation:	/E01/Data/String/Data/ST_Object.ST_Object
#. InfoMetaData:	"DevComment" : "가구 배치 목록에 노출되는 거북 봇 레이스 포스터 오브젝트명 (글로서리 포함)"
#. InfoMetaData:	"IsTranslatable" : "1"
#. InfoMetaData:	"MaxLen" : "0"
#. InfoMetaData:	"MaxLines" : "0"
#: /E01/Data/String/Data/ST_Object.ST_Object
