msgctxt "ST_Widget,Widget_Immigration_Guide_Desc9_Text"
msgid "낯선 거리에서 마주할 풍경도,\r\n처음 듣는 소리도 모두 새롭게 느껴질 거예요."
msgstr "낯선 거리에서 마주할 풍경도,\r\n처음 듣는 소리도 모두 새롭게 느껴질 거예요."

