msgid "향기로운 꽃집 등장! 새로운 사업이 찾아왔어요!"
msgstr "향기로운 꽃집 등장! 새로운 사업이 찾아왔어요!"

#. Key:	EventNotice_EvnetNoticePopupData_Pages_5_202603BirthDay_DescTextId
#. SourceLocation:	/Game/Data/String/UI/ST_EventNotice.ST_EventNotice
#. InfoMetaData:	"IsTranslatable" : "1"
