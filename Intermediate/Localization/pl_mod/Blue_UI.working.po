msgctxt "ST_Message,Message_JobDisabled_Desc_Text"
msgid "직업은 단순한 생계유지 수단이 아니다냥. 일을 하며 보람을 맛보게 하라냥!"
msgstr "Nie pracujesz tylko dla pieniędzy, miau. Znajdź sens i radość w swojej pracy, miau!"

msgctxt "ST_Message,Message_JobDisabled_Title_Text"
msgid "직업 선택의 시간"
msgstr "Czas wybrać swoją karierę"

msgctxt "ST_Message,Message_JobInducement_Desc_Text"
msgid "<CatTalk_Title>취업을 해 보면 어떨까냥?</>\r\n직업은 단순한 생계유지 수단이 아니다냥. 일을 하며 보람을 맛보게 하라냥!\r\n<img id=\"Bullet\"/><CatTalk_List>다양한 직업을 통해 자신의 가치를 발견할 수 있다냥.</>\r\n<img id=\"Bullet\"/><CatTalk_List>스마트폰</><img id=\"Phone\" width=\"22\" height=\"22\"/><CatTalk_List>의 JOB 앱을 통해 새로운 직장을 찾아보라냥!</>"
msgstr "<CatTalk_Title>Co powiesz na znalezienie pracy?</>\r\nPraca to nie tylko pieniądze, miau. Znajdziesz w niej także sens i radość, miau!\r\n<img id=\"Bullet\"/><CatTalk_List>Odblokuj swój potencjał, sprawdzając różne ścieżki kariery.</>\r\n<img id=\"Bullet\"/><CatTalk_List>Użyj aplikacji PRACA na smartfonie</><img id=\"Phone\" width=\"22\" height=\"22\"/><CatTalk_List>, aby znaleźć nową pracę, miau!</>"

msgctxt "ST_Message,Message_JobInducement_Link_Text"
msgid "스마트폰 열기"
msgstr "Użyj smartfona"

msgctxt "ST_Message,Message_JobInducement_Title_Text"
msgid "직업 선택의 시간!"
msgstr "Czas wybrać swoją karierę"

msgctxt "ST_Message,Message_JobRankDown_Desc_Text"
msgid "<CatTalk_Title>강등 알림</>\r\n안타깝다냥! {0}|hpp(으로,로) 강등되었다냥.<img id=\"Warning_02\" width=\"22\" height=\"22\"/>\r\n\r\n성실하게 근무하면 다시 승진할 기회가 있다냥.\r\n새로운 직책에서도 최선을 다해주길 바란다냥!"
msgstr "<CatTalk_Title>Powiadomienie o degradacji</>\r\nWielka szkoda, miau! Zdegradowano cię do stanowiska {0}<img id=\"Warning_02\" width=\"22\" height=\"22\"/>.\r\n\r\nJeśli będziesz solidnie pracować, pojawi się kolejna szansa na awans.\r\nDaj z siebie wszystko na nowym stanowisku, miau!"

msgctxt "ST_Message,Message_JobRankDown_Title_Text"
msgid "강등 알림"
msgstr "Powiadomienie o degradacji"

msgctxt "ST_Message,Message_JobRankUp_Desc_Text"
msgid "<CatTalk_Title>승진 알림</>\r\n축하한다냥! {0}|hpp(으로,로) 승진하여 새로운 직책을 맡게 됐다냥.<img id=\"Congrats_01\" width=\"22\" height=\"22\"/>\r\n승진하여 새롭게 받게 된 급여 등<img id=\"Congrats_03\" width=\"22\" height=\"22\"/>, \r\n직업 정보는 스마트폰<img id=\"Phone\" width=\"22\" height=\"22\"/>의 직장앱을 살펴보라냥.\r\n\r\n새로운 직책에서도 멋진 활약을 기대한다냥!<img id=\"Congrats_02\" width=\"22\" height=\"22\"/>"
msgstr "<CatTalk_Title>Powiadomienie o awansie</>\r\nGratulacje, miau! Otrzymujesz awans na stanowisko {0}.<img id=\"Congrats_01\" width=\"22\" height=\"22\"/>\r\nAby dowiedzieć się więcej o nowej pensji i szczegółach pracy<img id=\"Congrats_03\" width=\"22\" height=\"22\"/>, \r\nsprawdź aplikację PRACA na smartfonie<img id=\"Phone\" width=\"22\" height=\"22\"/>, miau.\r\n\r\nNie mogę się doczekać, żeby zobaczyć, jak poradzisz sobie w nowej roli!<img id=\"Congrats_02\" width=\"22\" height=\"22\"/>"

msgctxt "ST_Message,Message_JobRankUp_Title_Text"
msgid "승진 알림"
msgstr "Powiadomienie o awansie"

msgctxt "ST_Message,Message_JoinCompany_Desc_Text"
msgid "<CatTalk_Title>입사 알림</>\r\n{0} 취업을 축하한다냥!<img id=\"Congrats_01\" width=\"22\" height=\"22\"/>\r\n오늘을 제외한 가장 빠른 근무일부터 출근할 수 있다냥.\r\n\r\n3일 동안 결근하게 될 시 강제로 퇴사 처리되니 주의하라냥.\r\n근무 시간 및 급여 등은 스마트폰<img id=\"Phone\" width=\"22\" height=\"22\"/>의 직장앱을 살펴보라냥~"
msgstr "<CatTalk_Title>Powiadomienie o zatrudnieniu</>\r\nGratulacje z okazji nowej pracy w {0}, miau!<img id=\"Congrats_01\" width=\"22\" height=\"22\"/>\r\nMożesz rozpocząć pracę od następnego dnia roboczego, z pominięciem dzisiejszego.\r\n\r\nPamiętaj, że jeśli nie pojawisz się w pracy przez trzy dni, konieczna będzie rezygnacja.\r\nAby uzyskać szczegółowe informacje o godzinach pracy i wynagrodzeniu, sprawdź aplikację PRACA na swoim smartfonie.<img id=\"Phone\" width=\"22\" height=\"22\"/>"

msgctxt "ST_Message,Message_JoinCompany_Title_Text"
msgid "입사 알림"
msgstr "Powiadomienie o zatrudnieniu"

msgctxt "ST_Message,Message_JoinSchoolTest_Text"
msgid "입학했다냥! 즐거운 학교생활 하라냥!"
msgstr "Zapisano cię do szkoły, miau! Ciesz się szkolnym życiem, miau!"

msgctxt "ST_Message,Message_Karma_Involving_Complete_Text"
msgid "조이에게 효과가 적용됐습니다."
msgstr "Ten efekt został zastosowany do tego Zoi."

msgctxt "ST_Message,Message_LeaveCompany_ByAge_Desc_Text"
msgid "{0}에서 정년 퇴직했다냥. 모두가 당신을 그리워할 거다냥!"
msgstr "W końcu odchodzisz z {0}, miau! Na pewno będą za Tobą tęsknić, miau!"

msgctxt "ST_Message,Message_LeaveCompany_ByAge_Title_Text"
msgid "정년 퇴직 알림"
msgstr "Powiadomienie o przejściu na emeryturę"

msgctxt "ST_Message,Message_LeaveCompany_Desc_Text"
msgid "<CatTalk_Title>퇴사 알림</>\r\n안타깝다냥! 근무 태만으로 인해 {0}|hpp(에서,서) 퇴사 처리되었다냥.<img id=\"Warning_02\" width=\"22\" height=\"22\"/>\r\n\r\n급여 지급은 오늘부로 중단되며, 재입사하려면 입사 절차를 다시 밟아야 한다냥.\r\n그동안 수고 많았다냥. 앞으로의 길에 행운이 가득하길 바란다냥!"
msgstr "<CatTalk_Title>Powiadomienie o wypowiedzeniu</>\r\nCo za szkoda, miau! Wyrzucono cię z {0} z powodu słabych wyników.<img id=\"Warning_02\" width=\"22\" height=\"22\"/>\r\n\r\nWypłaty pensji zostają wstrzymane od dzisiaj i musisz ponownie aplikować, jeśli chcesz odzyskać pracę, miau.\r\nDzięki za wysiłek. Mam nadzieję, że twoja przyszłość będzie szczęśliwa, miau!"

msgctxt "ST_Message,Message_LeaveCompany_Title_Text"
msgid "퇴사 알림"
msgstr "Powiadomienie o rezygnacji"

msgctxt "ST_Message,Message_LeaveSchoolTest_Text"
msgid "자퇴를 했냥? 너만의 길을 응원하겠다냥!"
msgstr "Zakończono naukę, miau! Trzymam kciuki za ciebie i twoją własną ścieżkę, miau!"

