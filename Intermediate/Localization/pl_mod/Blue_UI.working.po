msgctxt "ST_FamilyMonitoringNotification,FamilyMonitoringNotification_AddFamilyMonitoringNotification_Visit_TransactionFraud_DescTextId"
msgid "{Self}|hpp(의,의) 중고거래 사기를 조사하기 위해 경찰이 방문했습니다. … 어떻게 하죠?"
msgstr "Policja przyjechała, żeby przeprowadzić śledztwo w sprawie oszustwa na sprzedaży komisowej popełnionego przez: {Self}. …Co zrobić?"

msgctxt "ST_FamilyMonitoringNotification,FamilyMonitoringNotification_AddFamilyMonitoringNotification_Visit_TransactionFraud_Fail_DescTextId"
msgid "{Self}|hpp(이,가) 중고거래 사기 혐의로 체포되고 말았습니다."
