msgstr "Sprawdzanie fortuny brzmi zabawnie!"

msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Hope_YearEnd_Kiss_MessageTextId"
msgid "새해 첫 키스하면 로맨틱할 거야!"
msgstr "Pierwszy pocałunek w Nowym Roku byłby romantyczny!"

msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_Hope_YearEnd_Plan_MessageTextId"
