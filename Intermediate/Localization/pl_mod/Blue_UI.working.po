msgstr "Obecnie nie ma dostępnych opiekunów. Nie możemy teraz zapewnić opieki nad dzieckiem."

msgctxt "ST_Message,Message_Service_ChildCare_Pending_Text"
msgid "돌봄 서비스 제공을 위해 아이돌보미를 배정 중입니다. 잠시만 기다려 주세요."
msgstr "Organizujemy opiekę dla twojego dziecka. Poczekaj chwilę."

msgctxt "ST_Message,Message_Service_ChildCare_Success_Text"
msgid "신청하신 아이 돌봄 서비스가 승인되어 아이돌보미가 집으로 오고 있습니다."
msgstr "Twoje zgłoszenie do usługi opieki nad dzieckiem zostało pomyślnie przyjęte."

msgctxt "ST_Message,Message_Service_ChildCare_TimeOut_Finish_Text"
msgid "우리 아이 돌봄 서비스 운영 시간이 종료되었습니다."
msgstr "Opieka nad dzieckiem dobiegła końca na dziś."

msgctxt "ST_Message,Message_Service_ChildCare_TimeOut_Text"
msgid "우리 아이 돌봄 서비스 운영 시간이 종료되었습니다."
msgstr "Opieka nad dzieckiem dobiegła końca na dziś."

msgctxt "ST_Message,Message_Service_FireExtinguish_Adding_Text"
msgid "<CatTalk_Title>소방서에 화재 진압을 요청했습니다.</>"
msgstr "<CatTalk_Title>Do remizy strażackiej wpłynęło zgłoszenie.</>"

msgctxt "ST_Message,Message_Service_FireExtinguish_Failure_Text"
msgid "<CatTalk_Title>현재 출동할 수 있는 소방대원이 없거나 해당 부지에 이미 같은 서비스가 진행중입니다.</>"
msgstr "<CatTalk_Title>Brak dostępnych strażaków lub akcja już trwa w nieruchomości.</>"

msgctxt "ST_Message,Message_Service_FireExtinguish_Finish_Text"
msgid "<CatTalk_Title>화재 진압 서비스가 정상적으로 완료되었습니다.</>"
msgstr "<CatTalk_Title>Udało się ugasić pożar.</>"

msgctxt "ST_Message,Message_Service_FireExtinguish_Pending_Text"
msgid "<CatTalk_Title>모든 소방대원이 출동중입니다.</>\r\n잠시만 기다려주세요"
msgstr "<CatTalk_Title>Wszyscy strażacy są obecnie zajęci.</>\r\nPoczekaj chwilę."

msgctxt "ST_Message,Message_Service_FireExtinguish_PendingQueue_Text"
msgid "<CatTalk_Title>[수정요] 화재 진압 대기열에 추가되었습니다.</>\r\n이 텍스트는 수정되어야 합니다."
msgstr "<CatTalk_Title>[Wymaga sprawdzenia] Dodano do kolejki gaszenia.</>\r\nTen tekst wymaga sprawdzenia."

msgctxt "ST_Message,Message_Service_FireExtinguish_Success_Text"
msgid "<CatTalk_Title>소방서에서 출동을 시작하였습니다.</>\r\n잠시만 기다려주세요"
msgstr "<CatTalk_Title>Remiza strażacka rozpoczęła działanie.</>\r\nStrażacy wkrótce przybędą na miejsce."

msgctxt "ST_Message,Message_Service_FireExtinguish_TimeOut_Text"
msgid "<CatTalk_Title>화재 진압 서비스가 종료되었습니다.</>"
msgstr "<CatTalk_Title>Pożar został ugaszony.</>"

msgctxt "ST_Message,Message_Service_Ghost_Exorcist_Adding_Text"
msgid "귀하께서 신고하신 사건을 영혼인도자가 접수하였습니다."
msgstr "Twoje zgłoszenie zostało odebrane przez Przewodnika duszy."

msgctxt "ST_Message,Message_Service_Ghost_Exorcist_Failure_Text"
msgid "귀하께서 신고하신 사건에 현재 출동할 수 있는 영혼인도자가 없습니다."
msgstr "Brak dostępnego Przewodnika duszy, aby obsłużyć zgłoszony incydent."

msgctxt "ST_Message,Message_Service_Ghost_Exorcist_Finish_Text"
msgid "귀하께서 신고하신 사건(영혼인도자 출동)이 처리 완료되었습니다."
msgstr "Twoje zgłoszenie (wysłanie Przewodnika duszy) zostało rozwiązane."

msgctxt "ST_Message,Message_Service_Ghost_Exorcist_Pending_Text"
msgid "신고가 접수되어 영혼인도자가 출동 중입니다.\r\n잠시 기다려주시기 바랍니다."
msgstr "Zgłoszenie zostało odebrane, Przewodnik duszy jest już w drodze.\r\nPoczekaj chwilę."

msgctxt "ST_Message,Message_Service_Ghost_Exorcist_Success_Text"
msgid "접수 완료, 영혼인도자가 출동을 시작하였습니다. \r\n출동에 다소 시간이 걸릴 수 있습니다.\r\n잠시 기다려주시기 바랍니다."
msgstr "Zgłoszenie zostało przetworzone, a Przewodnik duszy został wysłany.\r\nMoże to chwilę potrwać.\r\nPoczekaj chwilę."

msgctxt "ST_Message,Message_Service_Ghost_Exorcist_TimeOut_Text"
msgid "영혼인도자 업무 시간이 종료되었습니다."
msgstr "Przewodnik duszy zakończył zmianę. Czas na zasłużony odpoczynek!"

msgctxt "ST_Message,Message_Service_Police_CatchCrime_Adding_Text"
msgid "<CatTalk_Title>경찰서에서 범죄 신고를 받았습니다.</>"
msgstr "<CatTalk_Title>Zgłoszenie przestępstwa zostało odebrane przez posterunek policji.</>"

msgctxt "ST_Message,Message_Service_Police_CatchCrime_Failure_Text"
msgid "<CatTalk_Title>현재 출동할 수 있는 경찰관이 없습니다.</>"
msgstr "<CatTalk_Title>Brak dostępnych policjantów.</>"

msgctxt "ST_Message,Message_Service_Police_CatchCrime_Finish_Text"
msgid "<CatTalk_Title>상황이 종료 되었습니다.</>"
msgstr "<CatTalk_Title>Sytuacja została rozwiązana.</>"

msgctxt "ST_Message,Message_Service_Police_CatchCrime_Pending_Text"
msgid "<CatTalk_Title>모든 경찰관이 출동중입니다.</>잠시만 기다려주세요"
msgstr "<CatTalk_Title>Wysłano wszystkich policjantów.</>Poczekaj chwilę."

msgctxt "ST_Message,Message_Service_Police_CatchCrime_Success_Text"
msgid "<CatTalk_Title>경찰관이 출동했습니다.</>"
msgstr "<CatTalk_Title>Wysłano policjanta.</>"

msgctxt "ST_Message,Message_Service_Police_CatchCrime_TimeOut_Text"
msgid "<CatTalk_Title>경찰관이 용의자를 놓쳤습니다.</>"
msgstr "<CatTalk_Title>Policjant nie zdołał złapać podejrzanego.</>"

msgctxt "ST_Message,Message_Service_RandomVisitor_Adding_Text"
msgid "(None)집에 누군가 올 것 같습니다."
msgstr ""

msgctxt "ST_Message,Message_Service_RandomVisitor_Failure_Text"
msgid "(None)방문자가 돌아갔습니다."
msgstr ""

msgctxt "ST_Message,Message_Service_RandomVisitor_Finish_Text"
msgid "(None)방문자가 돌아갔습니다."
msgstr ""

msgctxt "ST_Message,Message_Service_RandomVisitor_Pending_Text"
msgid "(None)집에 누군가 찾아오는 것 같습니다."
msgstr ""

msgctxt "ST_Message,Message_Service_RandomVisitor_Success_Text"
msgid "(None)집에 누군가 찾아오는 것 같습니다."
msgstr ""

msgctxt "ST_Message,Message_Service_RandomVisitor_TimeOut_Text"
msgid "(None)방문자가 돌아갔습니다."
msgstr ""

msgctxt "ST_Message,Message_SharkHazard_AreaEnter_Text"
msgid "[상어 지역] 상어 위험 해역으로 들어왔습니다!"
msgstr "[Obszar występowania rekinów] W tych wodach występują rekiny!"

msgctxt "ST_Message,Message_ShipPurchaseBlockedMessage_Text"
msgid "선박이 이미 정박되어 있는 경우 선박을 대여할 수 없습니다."
msgstr "Nie można wynająć łodzi, gdy inna jest już zadokowana."

msgctxt "ST_Message,Message_Shop_OneHourLeft_Text"
msgid "매대 판매 마감까지 1시간 남았습니다."
msgstr "Pozostała 1 godzina do zakończenia wyprzedaży."

msgctxt "ST_Message,Message_Shop_OutofSite_Text"
msgid "플리마켓 장소를 벗어났습니다. 너무 멀리가면 손님이 판매자를 찾을 수 없습니다."
msgstr "Wychodzisz poza pchli targ. Jeśli zajdziesz za daleko, klienci nie będą mogli cię znaleźć."

msgctxt "ST_Message,Message_Shop_ReceivedTip_Text"
msgid "예상치 못한 행운이 발생했습니다! 부유한 손님이 기부를 하고 갔습니다."
msgstr "Co za niespodziewane szczęście! Bogaty gość właśnie przekazał datek."

msgctxt "ST_Message,Message_Shop_SoldItem_Text"
msgid "상품이 판매되었습니다! 수익이 조금씩 쌓이고 있습니다."
msgstr "Sprzedano przedmiot! Zarobki zaczynają się kumulować."

msgctxt "ST_Message,Message_Shop_TheftOccurred_Text"
msgid "도둑이 물건을 훔쳐 갔어요! 직접 찾아가 손해를 복구하세요!"
msgstr "Złodziej coś od ciebie ukradł! Wyśledź go, aby odzyskać swoją własność!"

msgctxt "ST_Message,Message_Shop_TheftSuccess_Text"
msgid "도둑을 잡는 데 성공하여 피해를 복구했습니다."
msgstr "Udaje ci się złapać złodzieja i odzyskać swoją własność."

msgctxt "ST_Message,Message_Sit_Drivers_Seat_Drive_Vehicle_Text"
msgid "탈것을 운전하려면 운전석에 앉아 주세요."
msgstr "Usiądź na fotelu kierowcy, aby prowadzić pojazd."

msgctxt "ST_Message,Message_Site_Fail_HasObjectInInventory_Text"
msgid "오브젝트를 보관하고 있는 가구는 보관함에 넣을 수 없습니다."
msgstr "Mebli służących do przechowywania nie można przekazać do magazynu."

msgctxt "ST_Message,Message_Site_Fail_PutInInventory_Text"
msgid "보관함이 가득차서 어쩌고 저쩌고.."
msgstr "Przechowalnia jest pełna"

msgctxt "ST_Message,Message_Site_LeaveCharacterByLostPermission_Text"
msgid "부지의 이용 권한을 잃어 현재 부지에서 퇴거되었습니다."
msgstr "Utracono prawo do używania tej nieruchomości. Wyrzucono cię z jej obszaru."

msgctxt "ST_Message,Message_Skill_LevelUp_Text"
msgid "{SkillName} 능력이 {SkillLevel} 레벨로 올랐습니다."
msgstr "Rozwinięto umiejętność {SkillName} na poziom {SkillLevel}."

msgctxt "ST_Message,Message_Sleepwalking_Interrupt_Text"
msgid "잠결에 행동하는 조이는 조작할 수 없습니다."
msgstr "Nie możesz kontrolować na wpół śpiącego Zoi."

msgctxt "ST_Message,Message_Sleepwalking_Target_Select_Text"
msgid "잠결에 행동하는 조이는 대상으로 지정할 수 없습니다."
msgstr "Nie możesz wybrać na cel wpół śpiącego Zoi."

msgctxt "ST_Message,Message_SmartoiPen_HintText_Text"
msgid "You know this world is all fake; You are an AI, not human - and you want others to know."
msgstr "Już wiesz, że ten świat to fikcja. Jesteś SI, a nie człowiekiem – pora, by inni też to odkryli!"

msgctxt "ST_Message,Message_Snorkeling_AreaEnter_Text"
msgid "깊은 바다 해역으로 들어왔습니다!"
msgstr "Jesteś na głębokich wodach!"

msgctxt "ST_Message,Message_SocialEvent_FixedOverride_CreateFail_Text"
msgid "{ScheduleName} 스케줄이 있어 이벤트 생성을 못합니다."
msgstr "Nie można utworzyć wydarzenia z powodu istniejącego harmonogramu {ScheduleName}."

msgctxt "ST_Message,Message_SocialEvent_FixedOverride_StartFail_Text"
msgid "(None) {0}|hpp(이,가) {ScheduleName}스케줄로 인해 새로운 이벤트에 참여할 수 없습니다."
msgstr ""

msgctxt "ST_Message,Message_SocialEvent_Invitation_Expired_Text"
msgid "아쉽게도 모집이 끝났어요! 다음에 기회가 되면 그때 참여해 주세요."
msgstr "Niestety, rekrutacja dobiegła końca. Zachęcamy do wzięcia udziału następnym razem, gdy tylko pojawi się taka możliwość."

msgctxt "ST_Message,Message_SocialEvent_OverrideSchedule_OverlapCancel_Text"
msgid "{ScheduleName} 스케줄이 {ScheduleName} 스케줄 일정과 겹쳐 취소되었습니다."
msgstr "Harmonogram {ScheduleName} został anulowany z powodu kolidowania z innym harmonogramem {ScheduleName}."

msgctxt "ST_Message,Message_Stuck_AutonomyTime_Text"
msgid "<img id=\"Warning_01\" width=\"22\" height=\"22\"/> <CatTalk_Title>{FamilyTitle} 가족 {CharacterName}|hpp(의,의) 자율 행동에 문제가 생겼다냥!</>\r\n자율 행동에 문제가 생기면 욕구가 부족해 조이가 위험해질 수 있다냥!\r\n<img id=\"Bullet\"/><CatTalk_List>조이가 움직일 수 없다면 비상 탈출</><img id=\"EmergencyExit\" width=\"22\" height=\"22\"/><CatTalk_List>로 조이를 구해주라냥.</>\r\n<img id=\"Bullet\"/><CatTalk_List>조이의 주변에 상호작용할 대상이 없다면 조이를 클릭해 집으로 보내주라냥.</>"
msgstr "<img id=\"Warning_01\" width=\"22\" height=\"22\"/><CatTalk_Title>{CharacterName} z rodziny {FamilyTitle} ma problem z autonomią, miau! </>\r\nGdy autonomia Zoi zawodzi, może nie być w stanie zaspokoić swoich potrzeb, co może doprowadzić do prawdziwej kociastrofy! \r\n<img id=\"Bullet\"/><CatTalk_List>Jeśli twój Zoi utknął, kliknij Ratunek awaryjny</><img id=\"EmergencyExit\" width=\"22\" height=\"22\"/><CatTalk_List>, aby udzielić pomocy.</>\r\n<img id=\"Bullet\"/><CatTalk_List>Jeśli w pobliżu nie ma nic do interakcji, kliknij na Zoi, aby odesłać go do domu!</>"

msgctxt "ST_Message,Message_Stuck_CurrencySalvation_Text"
msgid "<img id=\"Warning_01\" width=\"22\" height=\"22\"/> <CatTalk_Title>{FamilyTitle} 가족은 더 이상 생활 지원금을 받을 수 없다냥!</>\r\n긴급 생활 지원금을 이미 받아 더 이상 받을 수 없다냥. 참고하라냥!\r\n<img id=\"Bullet\"/><CatTalk_List>이제부터라도 직업을 구해 안정적으로 돈을 버는 것을 추천한다냥.</>\r\n<img id=\"Bullet\"/><CatTalk_List>스마트폰</><img id=\"Phone\" width=\"22\" height=\"22\"/><CatTalk_List>의 직업 앱을 통해 취업할 수 있으니 참고하라냥.</>"
msgstr "<img id=\"Warning_01\" width=\"22\" height=\"22\"/> <CatTalk_Title>Rodzina {FamilyTitle} nie może już otrzymywać funduszy z zasiłku, miau!</>\r\nJuż otrzymali awaryjny zasiłek, więc nie mogą dostać więcej.\r\n<img id=\"Bullet\"/><CatTalk_List>Rozważ znalezienie pracy, aby od tego momentu mieć pewne źródło dochodu, miau.</>\r\n<img id=\"Bullet\"/><CatTalk_List>Możesz skorzystać z aplikacji Kariera na swoim Smartfonie</><img id=\"Phone\" width=\"22\" height=\"22\"/><CatTalk_List>aby znaleźć pracę, miau.</>"

msgctxt "ST_Message,Message_Stuck_FamilyRelationship_Text"
msgid "<img id=\"Warning_02\" width=\"22\" height=\"22\"/> <CatTalk_Title>{FamilyTitle} 가족의 가족애 수치가 너무 낮다냥!</>\r\n지금이야말로 가족 간 화해가 필요한 시점이다냥.\r\n<img id=\"Bullet\"/><CatTalk_List>지속적으로 가족애가 낮다면 가족 구성원이 가출하거나 어린 조이가 학교를 땡땡이칠 수도 있게 된다냥.</>\r\n<img id=\"Bullet\"/><CatTalk_List>가족애가 낮은 가족 구성원 간 화해의 대화를 해 돈독하게 관계를 유지해 보라냥.</>"
msgstr "<img id=\"Warning_02\" width=\"22\" height=\"22\"/><CatTalk_Title>Relacje w rodzinie {FamilyTitle} są na bardzo niskim poziomie!</>\r\n Ważne jest, aby jak najszybciej się pogodzili, miau!\r\n<img id=\"Bullet\"/><CatTalk_List>Jeśli sytuacja się nie poprawi, ktoś może postanowić odejść, a młodsi członkowie rodziny mogą zacząć opuszczać szkołę, miau.</>\r\n<img id=\"Bullet\"/><CatTalk_List>Prowadź szczere rozmowy, aby wzmocnić więzi w rodzinie, miau.</>"

msgctxt "ST_Message,Message_Stuck_HomeDustyValue_Text"
msgid "<img id=\"Warning_01\" width=\"22\" height=\"22\"/> <CatTalk_Title>{FamilyTitle} 가족의 집이 더럽다냥!</>\r\n대청소를 한 번 깨끗이 해 보는 건 어떨까냥?\r\n<img id=\"Bullet\"/><CatTalk_List>주택 청결도가 낮으면 가족 간의 사이도 쉽게 나빠지게 된다냥.</>\r\n<img id=\"Bullet\"/><CatTalk_List>청소기나 빗자루 등 청소 도구를 활용하여 청소를 해야 한다냥!</>\r\n<img id=\"Bullet\"/><CatTalk_List>청소 도구는 건축모드 아이콘</><img id=\"Build\" width=\"22\" height=\"22\"/><CatTalk_List>이나 키보드의 [I]키로 건축모드에 접속하여 구매할 수 있다냥!</>"
msgstr "<img id=\"Warning_01\" width=\"22\" height=\"22\"/><CatTalk_Title>Fuj! Dom rodziny {FamilyTitle} tonie w bałaganie, miau!</>\r\nCzas na kocią akcję sprzątania!?\r\n<img id=\"Bullet\"/><CatTalk_List>Kurz i brud mogą zepsuć domową atmosferę, miau!</>\r\n<img id=\"Bullet\"/><CatTalk_List>Chwyć za odkurzacz, miotłę lub inne narzędzia i doprowadź wszystko do porządku!</>\r\n<img id=\"Bullet\"/><CatTalk_List>Możesz kupić środki czystości w trybie budowania, klikając ikonę trybu budowania </><img id=\"Build\" width=\"22\" height=\"22\"/><CatTalk_List> lub naciskając klawisz [I], miau!</>"

msgctxt "ST_Message,Message_Stuck_HomeFire_Text"
msgid "<img id=\"Warning_03\" width=\"22\" height=\"22\"/> <CatTalk_Title>{FamilyTitle} 가족의 집에 불이 났다냥!</>\r\n화재로 인해 조이가 죽게 될 수도 있다냥. \r\n어서 조이를 안전한 곳으로 대피시켜야 한다냥!\r\n<img id=\"Bullet\"/><CatTalk_List>불을 클릭하고, '불 끄기' 상호작용을 통해 불을 제거할 수 있다냥.</>\r\n<img id=\"Bullet\"/><CatTalk_List>다만, 불을 끄다 조이가 죽게 될 수도 있으니 조심하라냥!</>"
msgstr "<img id=\"Warning_03\" width=\"22\" height=\"22\"/><CatTalk_Title>Alarm, alarm! W domu rodziny {FamilyTitle} szaleje pożar, miau!</>\r\nTo poważne zagrożenie dla wszystkich domowników! \r\nNatychmiast ewakuuj wszystkich w bezpieczne miejsce, miau!\r\n<img id=\"Bullet\"/><CatTalk_List>Kliknij na ogień i wybierz interakcję Zgaś pożar, by go opanować.</>\r\n<img id=\"Bullet\"/><CatTalk_List>Ale ostrożnie – gaszenie ognia może być niebezpieczne, miau!</>"

msgctxt "ST_Message,Message_Stuck_NotEnoughBed_Text"
msgid "<img id=\"Warning_01\" width=\"22\" height=\"22\"/> <CatTalk_Title>{FamilyTitle} 가족의 집에 침대가 부족하다냥!</>\r\n침대가 모자라서 가족들이 잠을 잘 수 없다냥.\r\n<img id=\"Bullet\"/><CatTalk_List>침대가 더 필요하고 오래 못 자면 피로로 위험할 수도 있다냥!</>\r\n<img id=\"Bullet\"/><CatTalk_List>침대는 건축모드([I]키)에서 구매할 수 있다냥!</>"
msgstr "<img id=\"Warning_01\" width=\"22\" height=\"22\"/><CatTalk_Title>{FamilyTitle} W domu tej rodziny brakuje łóżek, miau!</>\r\nBrakuje łóżek, więc członkowie rodziny nie mogą spać prawidłowo.\r\n<img id=\"Bullet\"/><CatTalk_List>Załatw im więcej łóżek! Jeśli nie będą się wystarczająco wysypiać, mogą stać się niebezpiecznie wyczerpani, miau!</>\r\n<img id=\"Bullet\"/><CatTalk_List>Łóżka można kupić w trybie budowy (klawisz [I]), miau!</>"

msgctxt "ST_Message,Message_Stuck_NotEnoughStat_Text"
msgid "<img id=\"Warning_01\" width=\"22\" height=\"22\"/> <CatTalk_Title>{FamilyTitle} 가족 {CharacterName}|hpp(의,의) 욕구 수치가 너무 낮다냥!</>\r\n욕구 수치가 낮으면 조이가 죽게 될 수도 있다냥.\r\n조이 초상화의 왼쪽, 노랗거나 빨갛게 보이는 욕구 버튼을 클릭하면 현재 조이의 욕구 수치를 그래프로 확인할 수 있다냥!\r\n<img id=\"Space\"/>\r\n<img id=\"Bullet\"/><CatTalk_List></><img id=\"Food\" width=\"22\" height=\"22\"/><CatTalk_List>배고픔 욕구가 낮다면 냉장고를 눌러 음식을 먹게 해야 한다냥.</>\r\n<img id=\"Bullet\"/><CatTalk_List></><img id=\"Sleep\" width=\"22\" height=\"22\"/><CatTalk_List>수면 욕구가 낮다면 침대나 의자에서 잠을 자게 해야 한다냥.</>\r\n<img id=\"Bullet\"/><CatTalk_List></><img id=\"Toilet\" width=\"22\" height=\"22\"/><CatTalk_List>용변 욕구가 낮다면 변기를 사용해야 한다냥.</>\r\n<img id=\"Space\"/>\r\n<img id=\"Bullet\"/><CatTalk_List>이외에도 부족한 상태의 욕구 아이콘을 누르면 조이가 자동으로 욕구를 채우러 가게 될 거다냥!</>"
msgstr "<img id=\"Warning_01\" width=\"22\" height=\"22\"/><CatTalk_Title> {CharacterName} z rodziny {FamilyTitle} ma się kiepsko, miau!</>\r\nJeśli potrzeby spadną za nisko, może się to źle skończyć!\r\nKliknij żółtą lub czerwoną ikonę obok portretu, aby sprawdzić, czego najbardziej brakuje.\r\n<img id=\"Space\"/>\r\n<img id=\"Bullet\"/><CatTalk_List></><img id=\"Food\" width=\"22\" height=\"22\"/><CatTalk_List>Głód doskwiera? Kliknij lodówkę, miau!</>\r\n<img id=\"Bullet\"/><CatTalk_List></><img id=\"Sleep\" width=\"22\" height=\"22\"/><CatTalk_List>Zmęczenie? Do łóżka albo na fotel!</>\r\n<img id=\"Bullet\"/><CatTalk_List></><img id=\"Toilet\" width=\"22\" height=\"22\"/><CatTalk_List>A jeśli pora załatwić fizjologiczne potrzeby, lepiej spiesz się do łazienki!</>\r\n<img id=\"Space\"/>\r\n<img id=\"Bullet\"/><CatTalk_List>Kliknij na ikonę potrzeby, a wszystko samo się załatwi, miau!</>"

msgctxt "ST_Message,Message_System_CantUseSmartphone_Text"
msgid "아직 나이가 어려서 스마트폰을 사용할 수 없습니다."
msgstr "Ten Zoi jest za młody, aby używać smartfona."

msgctxt "ST_Message,Message_System_CarAccident_Text"
msgid "교통사고 처리 후 시간이 지났습니다."
msgstr "Od czasu wypadku drogowego upłynęło trochę czasu."

msgctxt "ST_Message,Message_System_CheckBagContents_Text"
msgid "가방 속 내용물을 확인해 보세요."
msgstr "Sprawdź zawartość torby."

msgctxt "ST_Message,Message_System_Marriage_Move_Cancel_Text"
msgid "이사를 완료하지 않아 결혼이 진행되지 않았습니다."
msgstr "Nie można przejść do małżeństwa, ponieważ nie zakończono przeprowadzki."

msgctxt "ST_Message,Message_System_ReasonText_FailedFindNearGridLocation_Text"
msgid "유효한 위치로 이동할 수 없습니다."
msgstr "Nie można przenieść się do prawidłowego miejsca."

msgctxt "ST_Message,Message_System_ReasonText_Obstructed_Text"
msgid "대상 근처에 물건이 있어 사용할 수 없습니다."
msgstr "Nie możesz tego użyć, ponieważ obok celu jest przedmiot."

msgctxt "ST_Message,Message_System_ReasonText_Occupied_Text"
msgid "다른 조이가 사용 중입니다. 잠시만 기다려 주세요."
msgstr "Używa tego inny Zoi. Poczekaj."

msgctxt "ST_Message,Message_System_ReasonText_Rotate_Text"
msgid "건축 모드에서 대상의 방향을 수정해 주세요."
msgstr "Przestaw obiekt w trybie budowania."

msgctxt "ST_Message,Message_System_ReasonText_Unavailable_Text"
msgid "사용할 수 없습니다."
msgstr "Nie możesz tego użyć."

msgctxt "ST_Message,Message_System_ReasonText_Unreachable_Text"
msgid "대상에게 이동할 수 없습니다."
msgstr "Nie możesz przejść w stronę celu."

msgctxt "ST_Message,Message_Tag_Empty_Message_Text"
msgid "입력 내용이 없습니다."
msgstr "Treść jest pusta."

msgctxt "ST_Message,Message_Tag_MaxCharError_Message_Text"
msgid "태그가 너무 길어요. 최대 100자로 조정해주세요."
msgstr "Twój tag jest za długi. Może mieć maksymalnie 100 znaków."

msgctxt "ST_Message,Message_Tag_MaxNumError_Message_Text"
msgid "태그 개수 초과."
msgstr "Przekroczono maksymalną liczbę tagów."

msgctxt "ST_Message,Message_Tax_Alert_Text"
msgid "공과금이 청구되었습니다. 가족 중 최연장자가 문자로 공과금을 납부할 수 있습니다."
msgstr "Czas opłacić rachunki domowe. Najstarszy członek rodziny może zrobić to wygodnie przez SMS."

msgctxt "ST_Message,Message_Tax_NotOldest_Family_Text"
msgid "주민세 납부가 완료되었습니다."
msgstr "Podatek rezydenta został opłacony."

msgctxt "ST_Message,Message_Toast_Crime_Schedule_Text"
msgid "오늘 밤 목표가 정해졌습니다. 일정표를 확인하세요."
msgstr "Dzisiejszy cel został ustalony. Sprawdź swój harmonogram."

msgctxt "ST_Message,Message_ToastMessage_NoSeat_Text"
msgid "앉을 수 있는 자리가 없습니다."
msgstr "Brak miejsca do siedzenia."

msgctxt "ST_Message,Message_TryToAdoption_SystemMessage_Text"
msgid "아이 입양은 개발 중입니다."
msgstr "Funkcja adopcji jest obecnie w trakcie rozwoju."

msgctxt "ST_Message,Message_UnablePutdownInInventoryObject_Text"
msgid "차 안에서는 물건을 내려놓을 수 없습니다."
msgstr "Nie można odkładać przedmiotów, będąc w pojeździe."

msgctxt "ST_Message,Message_Unauthorized_GaragePad_Text"
msgid "거주자 우선 주차 구역이므로 사용할 수 없습니다."
msgstr "Ten obszar jest wyznaczony jako parking z priorytetem dla mieszkańców, dlatego nie jest dostępny do użytku."

msgctxt "ST_Message,Message_UnauthorizedGaragePadMessage_Text"
msgid "사용 권한이 없는 주차 자리입니다."
msgstr "Nie masz uprawnień do korzystania z tego miejsca parkingowego."

msgctxt "ST_Message,Message_Vehicle_AllPassengersMustBeSeatedMessage_Text"
msgid "모든 승객이 자리에 앉아야 운행 가능합니다."
msgstr "Wszyscy pasażerowie muszą siedzieć, aby zacząć jazdę."

msgctxt "ST_Message,Message_Vehicle_CommonReturnToParkingPlaceMessage_Text"
msgid "탈것이 주차되었습니다."
msgstr "Twój pojazd jest zaparkowany."

msgctxt "ST_Message,Message_Vehicle_GroundClickMessage_Text"
msgid "도시 편집에서 목적지를 선택하고 '탈것을 통해 이동'을 클릭하면 이동할 수 있습니다."
msgstr "Wybierz cel w menu Edytowanie miasta i kliknij Jedź tutaj, aby udać się do tej lokalizacji."

msgctxt "ST_Message,Message_Vehicle_LaneDeviationWarningMessage_Text"
msgid "차선을 벗어났습니다. 차선에 복귀하지 않으면, 탈것이 자동으로 원래 차선으로 복귀합니다."
msgstr "Zjeżdżasz z pasa. Jeśli nie wrócisz na swój pas, pojazd zrobi to automatycznie."

msgctxt "ST_Message,Message_Vehicle_LaneReturnCompleteMessage_Text"
msgid "탈것이 차선을 벗어나 인근 차선으로 복귀했습니다."
msgstr "Pojazd zjechał z pasa i wrócił na pobliski pas."

msgctxt "ST_Message,Message_Vehicle_ManualDrivingNotAllowed_Text"
msgid "자동 운전 모드일 때는 직접 운전할 수 없습니다."
msgstr "W trybie automatycznej jazdy prowadzenie ręczne jest wyłączone."

msgctxt "ST_Message,Message_Vehicle_MotorcycleSpawnFailedMessage_Text"
msgid "탈 것을 가져올 수 없는 위치에 있습니다. 다른 자리에서 시도해주세요."
msgstr "Nie można tutaj odzyskać pojazdu. Spróbuj w innym miejscu."

msgctxt "ST_Message,Message_Vehicle_MoveWithVehicleArriveMessage_Text"
msgid "목적지에 도착하였습니다."
msgstr "Dojechano na miejsce."

msgctxt "ST_Message,Message_Vehicle_MoveWithVehicleCancelMessage_Text"
msgid "탈것을 이용한 자동 이동이 취소되었습니다."
msgstr "Automatyczne poruszanie przy użyciu pojazdu zostało anulowane."

msgctxt "ST_Message,Message_Vehicle_MoveWithVehicleFailedMessage_Text"
msgid "탈것을 통해 갈 수 없는 지역입니다. 도보로는 이동 가능합니다."
msgstr "Ten obszar jest niedostępny dla pojazdów. Możesz dostać się tu pieszo."

msgctxt "ST_Message,Message_Vehicle_NonOwnerInDriverSeatMessage_Text"
msgid "내 소유의 탈것이 아닙니다. 운전할 수 없습니다."
msgstr "Nie możesz jechać pojazdem, ponieważ nie należy do Ciebie."

msgctxt "ST_Message,Message_Vehicle_OtherPassengerHaveNotEnteredMessage_Text"
msgid "다른 조이를 기다리고 있는 동안에는 출발할 수 없습니다."
msgstr "Nie można wyjść podczas oczekiwania na innego Zoi."

msgctxt "ST_Message,Message_Vehicle_OtherPassengerHaveNotEnteredMessage_Tooltip_Text"
msgid "다른 조이를 기다리고 있는 동안에는 건너뛰기 기능을 사용할 수 없습니다."
msgstr "Nie można użyć funkcji pomijania podczas oczekiwania na innego Zoi."

msgctxt "ST_Message,Message_Vehicle_RideNotAllowedMessage_Text"
msgid "탑승이 불가능한 탈것입니다."
msgstr "Nie można wsiąść do tego pojazdu."

msgctxt "ST_Message,Message_Vehicle_SpawnFailedMessage_Text"
msgid "탈것에 탑승하기 위해서는 차도 가까이 이동해야 합니다."
msgstr "Podejdź bliżej drogi, aby wsiąść do pojazdu."

msgctxt "ST_Message,Message_Vehicle_TimeScaleFixed_Text"
msgid "직접 운전하는 경우, 시간이 1배속으로 고정됩니다."
msgstr "Podczas ręcznego prowadzenia prędkość odtwarzania jest ustawiona na 1x."

msgctxt "ST_Message,Message_Vehicle_VehicleDisableSellMessage_Text"
msgid "조이가 탈것에 탑승 중일 때는 탈것을 판매할 수 없습니다."
msgstr "Nie można sprzedaż pojazdu, gdy w środku jest Zoi."

msgctxt "ST_Message,Message_Vehicle_VehicleExitPositionInvalid_Text"
msgid "내릴 수 없습니다."
msgstr "Nie można opuścić pojazdu."

msgctxt "ST_Message,Message_Vehicle_VehiclePurchaseFailure_Text"
msgid "탈것을 구매할 수 없습니다."
msgstr "Nie można kupić tego pojazdu."

msgctxt "ST_Message,Message_Vehicle_VehicleSellFailureMessage_Text"
msgid "현재 다른 조이가 내 탈것을 이용하고 있어 {0} 판매에 실패했습니다."
msgstr "Nie można sprzedać {0}, ponieważ pojazd jest używany przez innego Zoi."

msgctxt "ST_Message,Message_Vehicle_VehicleSellSuccessMessage_Text"
msgid "{0} 탈것이 판매되었습니다."
msgstr "Sprzedano: {0}."

msgctxt "ST_Message,Message_Vehicle_VehicleTowingMessage_Text"
msgid "탈것이 일정 시간 이상 방치되어 자동으로 주차되었습니다."
msgstr "Pojazd został automatycznie zaparkowany po pozostawieniu go bez nadzoru przez określony czas."

msgctxt "ST_Message,Message_Vehicle_VehicleUnavailable_Text"
msgid "현재 다른 조이가 내 탈것을 이용하고 있습니다."
msgstr "Pojazd jest używany przez innego Zoi."

msgctxt "ST_Message,Message_WarningFired_Desc_Text"
msgid "하루 더 결근하면, 강제 퇴사 처리된다냥!<img id=\"Warning_02\" width=\"22\" height=\"22\"/>"
msgstr "Jeśli jeszcze raz nie pojawisz się w pracy bez uzasadnienia, stracisz pracę, miau!<img id=\"Warning_02\" width=\"22\" height=\"22\"/>"

msgctxt "ST_Message,Message_WarningFired_Title_Text"
msgid "결근 알림"
msgstr "Powiadomienie o nieusprawiedliwionej nieobecności"

msgctxt "ST_Message,Message_WorldMission_Salvation_NotOldest_Family_Text"
msgid "파산하여 긴급 생활 지원금이 지급되었습니다."
msgstr "Z powodu bankructwa przyznano nadzwyczajne wsparcie socjalne."

msgctxt "ST_Message,Message_ZoiGroup_FailRecruitCoop_Text"
msgid "이 행동을 할 수 있는 조이가 그룹에 없습니다."
msgstr "Żaden Zoi w grupie nie może wykonać tego działania."

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_202603BirthDay_TitleTextId"
msgid "Happy Birthday, inZOI! 첫 번째 생일이 찾아왔어요"
msgstr "Sto lat, inZOI! Przybyły twoje pierwsze urodziny!"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_2026HappyNewYear_TitleTextId"
msgid "inZOI: 설날 이벤트가 찾아왔어요"
msgstr "inZOI: Wydarzenie z okazji Księżycowego Nowego Roku jest tutaj"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Halloween2025_TitleTextId"
msgid "inZOI: 할로윈 시즌이 시작됐어요"
msgstr "inZOI: Zaczyna się Halloween"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_HolydayFestival_InGame_TitleTextId"
msgid "inZOI: 홀리데이 페스티벌이 시작됐어요"
msgstr "inZOI: Festiwal Świąteczny Rozpoczyna Się"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_HolydayFestival_Lobby_TitleTextId"
msgid "inZOI: 홀리데이 페스티벌이 시작됐어요"
msgstr "inZOI: Festiwal wakacyjny rozpoczyna się"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_1_202603BirthDay_DescTextId"
msgid "inZOI가 출시 1주년을 맞이했습니다! 이 특별한 날까지 함께해 주신 모든 분들께 진심으로 감사드립니다.\r\n\r\n1주년을 기념하여 특별한 1주년 기념 케이크가 게임에 새롭게 추가되었어요. \r\n\r\n· 직접 재료를 모아 요리해 먹을 수도 있고, 포켓마켓에서 간편하게 구매할 수도 있습니다. \r\n\r\n· 사업장에서 판매 아이템으로 활용하는 것도 가능하니, 달콤한 생일의 기쁨을 손님들과 함께 나눠 보세요!"
msgstr "inZOI świętuje swoją pierwszą rocznicę! Z całego serca dziękujemy wszystkim, którzy towarzyszyli nam do tego wyjątkowego dnia.\r\n\r\nNa tę okazję, wprowadziliśmy do gry specjalne ciasto upieczone na pierwszą rocznicę:\r\n\r\n- Możesz zebrać składniki i upiec je samodzielnie, lub po prostu kupić je na Targu. \r\n\r\n- Może ono również służyć jako przedmiot do sprzedaży w Twojej firmie, więc dlaczego by nie podzielić się słodyczą tej urodzinowej celebracji ze swoimi klientami!"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_1_202603BirthDay_SubTitleTextId"
msgid "inZOI가 한 살이 됐어요! 곁에 있어줘서 고마워요"
msgstr "inZOI obchodzi pierwsze urodziny! Dziękujemy, że jesteście z nami!"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_1_2026HappyNewYear_DescTextId"
msgid "◉ 2026년, 말처럼 힘차게 달려갈 준비 되셨나요?\r\n◉ 캔버스에서 'Palet'를 찾아 귀여운 말머리 가면을 받아보세요!\r\n◉ 'Palet'는 AR컴퍼니의 창작물 관리자로 캔버스에서 만나볼 수 있습니다."
msgstr "Czy jesteś gotowy z pełnym wigorem wskoczyć w siodło i galopem wbiec w 2026 rok? \r\n◉ Znajdź 'Palet' na płótnie i zdobądź uroczą maskę z głową konia! \r\n◉ 'Palet' to Menedżer ds. kreacji w AR Company, którego można spotkać na płótnie."

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_1_2026HappyNewYear_SubTitleTextId"
msgid "2026년은 말의 해! 특별한 설날 선물이 도착했어요!"
msgstr "2026 to Rok Konia! Przybył specjalny prezent z okazji Księżycowego Nowego Roku!"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_1_Halloween2025_DescTextId"
msgid "inZOI의 첫 할로윈을 즐기고 싶다면?\r\n캔버스에서 'Palet'를 찾아 특별한 할로윈 코스튬을 받아보세요!\r\n'Palet'는 AR컴퍼니의 창작물 관리자로 캔버스에서 만나볼 수 있습니다."
msgstr "Chcesz świętować pierwsze Halloween w inZOI?\r\nZnajdź „Paletę” w Canvas, aby otrzymać specjalny kostium na Halloween!\r\n„Paleta” to dzieło menedżera firmy AR, które można znaleźć w Canvas."

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_1_Halloween2025_SubTitleTextId"
msgid "할로윈을 더욱 특별하게 즐겨보세요!"
msgstr "Niech to Halloween będzie jeszcze bardziej wyjątkowe!"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_1_HolydayFestival_InGame_DescTextId"
msgid "inZOI의 첫 홀리데이 페스티벌을 즐기고 싶다면?\r\n캔버스에서 'Palet'를 찾아 특별한 홀리데이 페스티벌 코스튬을 받아보세요!\r\n'Palet'는 AR컴퍼니의 창작물 관리자로 캔버스에서 만나볼 수 있습니다."
msgstr "Chcesz świętować pierwszy Festiwal Świąteczny inZOI?\r\nZnajdź „Palet” na Canvas, aby zdobyć specjalny kostium na Festiwal Świąteczny!\r\n„Palet” jest menedżerem kreacji w AR Company i można go znaleźć na Canvas."

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_1_HolydayFestival_InGame_SubTitleTextId"
msgid "환영합니다, 홀리데이 페스티벌에!"
msgstr "Witamy na Festiwalu wakacyjnym!"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_1_HolydayFestival_Lobby_DescTextId"
msgid "inZOI의 첫 홀리데이 페스티벌을 즐기고 싶다면?\r\n캔버스에서 'Palet'를 찾아 특별한 홀리데이 페스티벌 코스튬을 받아보세요!\r\n'Palet'는 AR컴퍼니의 창작물 관리자로 캔버스에서 만나볼 수 있습니다."
msgstr "Chcesz świętować pierwszy Festiwal Świąteczny inZOI?\r\nZnajdź „Palet” na Canvas, aby zdobyć specjalny kostium na Festiwal Świąteczny!\r\n„Palet” jest menedżerem ds. kreacji w AR Company i można go znaleźć na Canvas."

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_1_HolydayFestival_Lobby_SubTitleTextId"
msgid "환영합니다, 홀리데이 페스티벌에!"
msgstr "Witaj na Festiwalu wakacyjnym!"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_2_202603BirthDay_DescTextId"
msgid "도시 곳곳의 부지가 새롭게 단장되었습니다!\r\n모든 부지 크기가 7개 타입으로 규격화되어 건축물의 호환성이 높아졌으며, 캔버스를 통해 더 많은 유저들과 자유롭게 부지를 공유할 수 있게 되었습니다.\r\n\r\n이어하기 시 신규 업데이트가 필요한 부지들은 팝업으로 안내됩니다.\r\n만약 그 중, 직접 꾸민 부지가 있다면 업데이트 여부를 선택하는 팝업이 나타납니다. \r\n업데이트 시 부지는 기본 상태로 초기화되지만, 기존 건축물은 부지 프리셋에 자동 저장되어 언제든 다시 불러올 수 있어요. \r\n\r\n단, 정화파크빌 · 서머셋 플레이스 203번지는 부지 크기가 축소되어 저장했거나 캔버스에서 다운받은 프리셋 일부가 잘릴 수 있는 점 양해 부탁드립니다. \r\n업데이트하지 않은 부지는 옵션 → 게임플레이 → 수동 부지 최신화에서 나중에도 업데이트할 수 있습니다.\r\n\r\n자세한 내용은 패치 노트를 참고해 주세요."
msgstr "Nieruchomości na terenie całego miasta zostały zmodernizowane!\r\nWszystkie rozmiary nieruchomości zostały ujednolicone do siedmiu typów, co zwiększa kompatybilność budynków i umożliwia większej liczbie użytkowników swobodne udostępnianie nieruchomości za pośrednictwem Canvas.\r\n\r\nO potrzebie aktualizacji nieruchomości zostaniesz powiadomiony poprzez wyskakujące okienko po kontynuacji gry.\r\nJeśli posiadasz nieruchomość, którą samodzielnie dostosowałeś, pojawi się okienko dialogowe, w którym będziesz mógł zdecydować, czy chcesz ją zaktualizować, czy nie. \r\nPo aktualizacji nieruchomość zostanie zresetowana do stanu podstawowego, ale istniejące budynki zostaną automatycznie zapisane w szablonie nieruchomości, co umożliwi Ci ich odzyskanie w dowolnym momencie. \r\n\r\nProsimy jednak o zrozumienie, że dla Junghwa Parkville i 203 Somerset Place rozmiar nieruchomości został zmniejszony, co może skutkować obcięciem niektórych zapisanych lub pobranych z Canvas ustawień początkowych. \r\nNieruchomości, które nie zostały jeszcze zaktualizowane, mogą zostać zaktualizowane później, przechodząc do Opcje → Rozgrywka → Ręczna aktualizacja nieruchomości.\r\n\r\nSzczegółowe informacje znajdziesz w informacjach o łatce."

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_2_202603BirthDay_SubTitleTextId"
msgid "도시가 새로워졌어요 - 부지 신규 업데이트 안내"
msgstr "Miasto przeszło gruntowną modernizację - prezentujemy nowe aktualizacje dotyczące nieruchomości"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_2_Halloween2025_DescTextId"
msgid "할로윈 이벤트 기간, 집에 사탕 바스켓을 배치하면 매일 오후 5시에 아이들이 찾아옵니다."
msgstr "Umieść koszyk z cukierkami przy domu podczas Halloween, aby dzieci odwiedzały cię o 17:00 każdego dnia."

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_2_Halloween2025_SubTitleTextId"
msgid "아이들에게 사탕을 나눠주고 다양한 할로윈 장식을 모아보세요!"
msgstr "Daj dzieciom cukierki i odbierz różne dekoracje na Halloween!"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_3_202603BirthDay_DescTextId"
msgid "마음에 드는 조이를 만났다면, '연락처 물어보기'로 직접 번호를 교환해 보세요! \r\n고백이나 동거처럼 관계가 깊어지는 순간에는 연락처가 자동으로 등록되니 걱정 마세요. \r\n연락처가 있는 조이에게는 전화를 걸거나 받을 수 있고, 관계에 맞는 다양한 대화 주제가 펼쳐집니다. \r\n삭제한 연락처는 다시 요청할 수 있고, 차단당했더라도 풀어달라고 할 수 있어요. \r\n\r\n연락처가 있어야 문자, 전화, 만남 이벤트가 발생하니 친해지고 싶은 조이를 발견했다면 연락처를 교환해 보세요!"
msgstr "Jeśli natknąłeś się na radość, która przyciągnęła Twoją uwagę, spróbuj skorzystać z opcji \"Poproś o kontakty\", aby bezpośrednio wymienić się numerami telefonów! \r\nNie ma powodu do zmartwień, ponieważ Twoje kontakty zostaną automatycznie zarejestrowane, gdy Wasze relacje się pogłębią, na przykład gdy wyznasz swoje uczucia lub zdecydujesz się zamieszkać razem. \r\nPosiadając kontakt, możesz dzwonić do radości lub odbierać od niej połączenia, a także prowadzić rozmowy na różne tematy, które są zgodne z Waszymi relacjami. \r\nMożesz poprosić o przywrócenie usuniętych kontaktów, a nawet jeśli zostałeś zablokowany, możesz poprosić o odblokowanie. \r\n\r\nPamiętaj, że wiadomości tekstowe, połączenia i wydarzenia spotkań mają miejsce tylko wtedy, gdy masz kontakty, więc jeśli natknąłeś się na radość, do której chciałbyś się zbliżyć, spróbuj wymienić się kontaktami!"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_3_202603BirthDay_SubTitleTextId"
msgid "번호 좀 알 수 있을까요? - 연락처와 전화"
msgstr "Czy mogę prosić o Twój numer? - Kontakty i Telefon"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_3_Halloween2025_DescTextId"
msgid "낮은 확률로 나타나는 유령 물고기는 기존 낚시 방식 그대로 잡을 수 있어요."
msgstr "Szansa złowienia ryby-ducha jest niewielka, ale można tego dokonać, używając zwykłych wędkarskich metod."

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_3_Halloween2025_SubTitleTextId"
msgid "밤에 바다와 호수에서 유령 물고기를 낚아보세요."
msgstr "Spróbuj złowić rybę-ducha nocą w oceanie lub jeziorze."

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_4_202603BirthDay_DescTextId"
msgid "사업의 세계가 더 넓어졌습니다! 이제 꽃집을 운영해볼 수 있어요. \r\n\r\n· 꽃집: 장미, 카네이션, 거베라, 튤립, 국화, 백합으로 꽃다발과 꽃바구니를 직접 만들어 판매하세요. 사업 설정의 '설정 템플릿'에서 '꽃집'을 선택하면 기본 세팅이 자동 적용됩니다. 꽃을 직접 갖고 있지 않아도 제작 시 꽃값이 자동 차감되니 부담 없이 시작해 보세요! \r\n\r\n더불어, 사업장에 팁 통을 배치하면 서비스에 만족한 손님이 팁을 남기게 되었습니다. 손님을 만족시키고 추가 수익을 얻어 보세요!"
msgstr "Świat firmy stał się jeszcze większy! Teraz możesz prowadzić sklep z kwiatami. \r\n\r\n· Sklep z kwiatami: Samodzielnie twórz i sprzedawaj bukiety oraz kosze kwiatowe z róż, goździków, gerber, tulipanów, chryzantem i lilii. Wybierz 'Sklep z kwiatami' z 'Szablonu ustawień' w Ustawieniach firmy, aby automatycznie zastosować domyślną konfigurację. Nawet jeśli nie masz żadnych kwiatów pod ręką, koszt kwiatów zostanie automatycznie odliczony podczas tworzenia, więc możesz zacząć z łatwością! \r\n\r\nDodatkowo, jeśli umieścisz słoik na napiwki w swojej firmie, zadowoleni klienci mogą zostawić napiwek. Zadbaj o zadowolenie swoich klientów i zyskaj dodatkowy dochód!"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_4_202603BirthDay_SubTitleTextId"
msgid "향기로운 꽃집 등장! 새로운 사업이 찾아왔어요!"
msgstr "Uroczy sklep z kwiatami został otwarty! Pojawiła się nowa okazja do prowadzenia biznesu!"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_5_202603BirthDay_DescTextId"
msgid "도원, 블리스베이, 차하야 세 도시에 VIP 라운지가 새롭게 문을 열었습니다! \r\n\r\n· 도원: 스카이 라운지 공명 3층 \r\n\r\n· 블리스베이: 엘레강스 호텔 & 클럽 3층\r\n\r\n· 차하야: 비치클럽 2층\r\n\r\nVIP 라운지에서는 전용 음료를 즐기고, 화려한 분위기 속에서 특별한 밤을 보낼 수 있어요. \r\nVIP 라운지를 지키는 가드, 바텐더, 직원이 VIP인 여러분에게 최고의 서비스를 제공합니다. \r\n\r\n도시의 밤 문화를 한층 더 즐겨 보세요!"
msgstr "Nowo otwarte salony VIP czekają na Ciebie w trzech miastach: Dowon, Bliss Bay i Cahaya! \r\n\r\n- Dowon: Lounge Gongmyeong, 3. piętro \r\n\r\n- Bliss Bay: Hotel i klub nocny Elegance, 3. piętro \r\n\r\n- Cahaya: Klub plażowy, 2. piętro\r\n\r\nW salonach VIP możesz delektować się wyjątkowymi napojami i doświadczyć niezapomnianej nocy w oszałamiającej atmosferze. \r\nNasi ochroniarze, barmani i personel są całkowicie oddani, aby zapewnić Tobie, naszym szanownym gościom VIP, obsługę najwyższej klasy. \r\n\r\nPodnieś swoje doznania z nocnego życia miasta!"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_5_202603BirthDay_SubTitleTextId"
msgid "도시의 밤이 더 화려해집니다 - VIP 라운지 오픈!"
msgstr "Nocne życie w mieście właśnie stało się jeszcze bardziej błyszczące - Lounge VIP jest już otwarty!"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_6_202603BirthDay_DescTextId"
msgid "가족 달력이 추가되었습니다! \r\n\r\n달력에서는 다가오는 공휴일, 생일, 출산일 등 주요 일정을 한눈에 확인할 수 있어요. \r\n중요한 날에는 특별한 표시가 나타나니 가족의 중요한 이벤트를 미리 준비해 보세요. \r\n공휴일에는 공원이나 광장에서 화려한 축제가 열립니다. \r\n축제마다 다양한 테마의 연출이 준비되어 있고, 평소와 다른 특별한 상호작용도 즐길 수 있어요. \r\n\r\n축제 부스 방문, 특별한 음식 구매 등 다채로운 활동을 놓치지 마세요!"
msgstr "Dodano kalendarz dla całej rodziny! \r\n\r\nKalendarz umożliwia łatwe śledzenie nadchodzących świąt, urodzin, rocznic narodzin oraz innych istotnych wydarzeń. \r\nSpecjalne oznaczenia pojawiają się w dniach ważnych, co pozwala na wcześniejsze zaplanowanie rodzinnych uroczystości. \r\nPodczas świąt, w parkach i na placach odbywają się pełne życia festiwale. \\Każdy z nich ma unikalny temat i daje możliwość nawiązania specjalnych interakcji, które odbiegają od codzienności. \r\n\r\nNie przegap różnorodnych atrakcji, takich jak odwiedzanie stoisk festiwalowych czy degustacja specjalnych potraw!"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_6_202603BirthDay_SubTitleTextId"
msgid "오늘은 무슨 날? - 달력과 공휴일"
msgstr "Jaki mamy dzisiaj dzień? - Kalendarz i święta państwowe"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_7_202603BirthDay_DescTextId"
msgid "내 조이의 생일은 물론, 가족과 친구의 생일에도 생일 파티를 열 수 있습니다. \r\n\r\n케이크를 굽고, 조이의 성장을 함께 축하하며 특별한 하루를 보내 보세요! \r\n케이크의 초를 불면 조이가 한 살 더 성장합니다. \r\n혼자서 성장하지 못하는 신생아와 유아는 생일이 되면 어른 조이가 성장시켜 줍니다. \r\n\r\n생일 케이크를 준비하고, 성장시키고픈 주인공을 위한 생일 파티를 열어 주세요!\r\n만약 깜빡하고 케이크를 준비하지 못하면, 생일이 지나고 혼자 조용히 자축하며 성장하는 조이를 보게 될 거예요. \r\n\r\n조이가 행복하게 성장할 수 있도록 꼭 케이크를 준비해 주세요!"
msgstr "Możesz organizować imprezy urodzinowe nie tylko dla swojego Zoi, ale także dla członków rodziny i przyjaciół Wł. ich urodziny. \r\n\r\nUpiecz Ciasto, świętujcie razem rozwój swojego Zoi i uczcie ten dzień wyjątkowym! \r\nGdy świeczki na Cieście zostaną zdmuchnięte, Zoi staje się o rok starszy. \r\nNoworodki i małe dzieci, które nie mogą samodzielnie dorosnąć, otrzymają pomoc od Zoi w wieku dorosłym, gdy nadejdzie ich urodziny. \r\n\r\nPrzygotuj Ciasto urodzinowe i zorganizuj imprezę urodzinową dla tego, komu chcesz pomóc dorosnąć! \r\nJeśli zapomnisz przygotować Ciasto, po upływie urodzin zobaczysz, jak Zoi samotnie świętuje i dorasta. \r\n\r\nPamiętaj, aby przygotować Ciasto, aby twój Zoi mógł szczęśliwie dorastać!"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_7_202603BirthDay_SubTitleTextId"
msgid "생일 축하해, 내 조이! - 생일 이벤트"
msgstr "Sto lat, mój Zoi! - Wydarzenie urodzinowe"

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_8_202603BirthDay_DescTextId"
msgid "조이의 최근 기억과 인생의 중요한 순간이 기록됩니다!\r\n\r\n최근 기억에는 다른 조이와의 의미 있는 대화가 저장되며, 당시의 감정도 함께 기록됩니다.\r\n또 조이들은 지난 기억을 떠올리며 화를 내거나 사과를 요구하는 등 기억을 바탕으로 한 다양한 대화를 나눌 수 있어요.\r\n\r\n특별히 중요한 순간은 이정표로 기록됩니다. 첫 취업, 결혼, 아이의 탄생 등 인생의 큰 사건들이 이정표로 남습니다.\r\n조이카드에서 최근 기억과 이정표를 한눈에 확인해보세요."
msgstr "Twoje najnowsze wspomnienia i znaczące wydarzenia z życia są udokumentowane!\r\n\r\nNajnowsze wspomnienia zawierają istotne rozmowy z innymi Joys, jak również emocje, które towarzyszyły Ci w tych momentach. Co więcej, Joys potrafią przypominać sobie dawne wspomnienia i prowadzić na ich podstawie różnorodne rozmowy, takie jak wyrażanie gniewu czy proszenie o przeprosiny.\r\n\r\nSzczególnie ważne chwile są zapisywane jako kamienie milowe. Duże wydarzenia życiowe, takie jak zdobycie pierwszej pracy, zawarcie małżeństwa czy narodziny dziecka, są zachowywane jako kamienie milowe.\r\nZajrzyj na swoją kartę Joycard, aby na pierwszy rzut oka zobaczyć swoje najnowsze wspomnienia i kamienie milowe."

msgctxt "ST_PerDLCUIInfo,PerDLCUIInfo_DLCWelcomePopupData_Pages_8_202603BirthDay_SubTitleTextId"
msgid "소중한 순간은 기억에 남으니까 - 기억과 이정표"
msgstr "Ponieważ ulotne chwile zostają w naszej pamięci - Wspomnienia i Miejsca Pamięciowe"

