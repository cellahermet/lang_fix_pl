msgctxt "ST_UI,UI_Map_MoveFamilySelect_Text"
msgid "입주 가족 선택"
msgstr "Wybierz rodzinę, która ma się wprowadzić"

msgctxt "ST_UI,UI_Map_MoveFamilySelect_Title_Text"
msgid "입주 가족 선택"
