msgstr "{Self} cierpi z powodu bólu zęba. Kup lekarstwo w aplikacji Pocket Market i weź je."

msgctxt "ST_FamilyMonitoringNotification,FamilyMonitoringNotification_AddFamilyMonitoringNotification_Toothache_Warning_TitleTextId"
msgid "위험 알림"
