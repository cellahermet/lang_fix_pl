msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_SpeechBubble_GroupContext_AdultTalking_Act3_1_T_MessageTextId"
msgid "어머, 저도 그거 사려고 했는데!"
msgstr "Och, ja też zamierzam to kupić!"

msgctxt "ST_SpeechBubble,SpeechBubble_SpeechBubbleData_1_SpeechBubble_GroupContext_AdultTalking_Act4_1_T_MessageTextId"
msgid "그냥 요즘은 행복해요…"
