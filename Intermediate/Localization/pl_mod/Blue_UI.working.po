msgctxt "ST_UI,UI_BlissBay_DietIsDangerous_Quest_Tooltip_Text"
msgid "<img id=\"Alert_Blue\"/> <Alert_Blue_Tooltip>봉분, 석묘는 공동묘지에서 찾을 수 있습니다.</>\r\n부탁을 해결하면, 클레어를 통해 카르마를 얻을 수 있습니다."
msgstr "<img id=\"Alert_Blue\"/><Alert_Blue_Tooltip>Kurhany i nagrobki kamienne można znaleźć na cmentarzu.</>\r\nZrealizuj prośbę, aby otrzymać karmę od Claire."

msgctxt "ST_UI,UI_BlissBay_DreamOfPianist_Quest_Tooltip_Text"
msgid "<img id=\"Alert_Blue\"/> <Alert_Blue_Tooltip>피아노는 피아니스트 유령의 근처에서 찾을 수 있습니다.</>\r\n부탁을 해결하면, 클레어를 통해 카르마를 얻을 수 있습니다."
msgstr "<img id=\"Alert_Blue\"/><Alert_Blue_Tooltip>Pianino można znaleźć obok ducha pianisty.</>\r\nZrealizuj prośbę, aby otrzymać karmę od Claire."

msgctxt "ST_UI,UI_BlissBay_LostUmbrella_Quest_Tooltip_Text"
msgid "도시 곳곳에 배치된 물건들을 활용해 유령의 부탁을 이루세요.\r\n부탁을 해결하면, 클레어를 통해 카르마를 얻을 수 있습니다.\r\n<img id=\"Alert_Blue\"/> <Alert_Blue_Tooltip>고양이는 공원 및 길거리에서 찾을 수 있습니다.</>"
msgstr "Użyj przedmiotów rozrzuconych po mieście, aby zrealizować prośbę ducha.\r\nUkończ ją, aby otrzymać karmę od Claire.\r\n<img id=\"Alert_Blue\"/> <Alert_Blue_Tooltip>Koty można znaleźć w parkach i na ulicach.</>"

msgctxt "ST_UI,UI_BlissBay_UnfinishedCouple_Quest_Tooltip_Text"
msgid "도시 곳곳에 배치된 물건들을 활용해 유령의 부탁을 이루세요.\r\n부탁을 해결하면, 클레어를 통해 카르마를 얻을 수 있습니다.\r\n<img id=\"Alert_Blue\"/> <Alert_Blue_Tooltip>채굴 포인트는 학교 및 클로버 공원에서 쉽게 찾을 수 있습니다.</>"
msgstr "Użyj przedmiotów rozrzuconych po mieście, aby zrealizować prośbę ducha.\r\nUkończ ją, aby otrzymać karmę od Claire.\r\n<img id=\"Alert_Blue\"/><Alert_Blue_Tooltip>Obszary górnicze można znaleźć obok szkół i w parku Clover.</>"

msgctxt "ST_UI,UI_BlissBay_UnsentLetter_Quest_Tooltip_Text"
msgid "도시 곳곳에 배치된 물건들을 활용해 유령의 부탁을 이루세요.\r\n부탁을 해결하면, 클레어를 통해 카르마를 얻을 수 있습니다.\r\n<img id=\"Alert_Blue\"/> <Alert_Blue_Tooltip>우체통은 농업 상점 주변에서 찾을 수 있습니다.</>"
msgstr "Użyj przedmiotów rozrzuconych po mieście, aby zrealizować prośbę ducha.\r\nUkończ ją, aby otrzymać karmę od Claire.\r\n<img id=\"Alert_Blue\"/><Alert_Blue_Tooltip>Skrzynkę pocztową można znaleźć obok sklepu z zaopatrzeniem rolniczym.</>"

