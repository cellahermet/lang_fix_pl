msgstr "<img id=\"Alert_Red\"/><Alert_desc>Nie można dodawać wpisów w harmonogramie dla noworodków i małych dzieci.</>"

msgctxt "ST_Message,Message_ScheduleEditTooltip_MinTimeUnsatisfied_Text"
