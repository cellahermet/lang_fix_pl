msgctxt "ST_UI,UI_Map_MoveInfoDesc1_Text"
msgid "모든 가구 보관\r\n<ToolTip_Main>거주했던 부지의 모든 가구가 보관함으로 이동됩니다.</>\r\n<img id=\"Space\"/>\r\n모든 가구 판매\r\n<ToolTip_Main>거주했던 부지의 모든 가구가 판매되고 환급됩니다.</>\r\n<img id=\"Space\"/>\r\n<img id=\"Space\"/>\r\n<img id=\"Alert_Blue\"/> <Alert_Blue_Tooltip>이사 후 부지는 처음 상태로 초기화 됩니다.</>"
msgstr "Przechowaj wszystkie meble\r\n<ToolTip_Main>Wszystkie meble z obecnej nieruchomości zostaną wysłane do przechowalni.</>\r\n<img id=\"Space\"/>\r\nSprzedaj wszystkie meble\r\n<ToolTip_Main>Wszystkie meble z obecnej nieruchomości zostaną sprzedane.</>\r\n<img id=\"Space\"/>\r\n<img id=\"Space\"/>\r\n<img id=\"Alert_Blue\"/> <Alert_Blue_Tooltip>Po przeprowadzce nieruchomość zostanie przywrócona do pierwotnego stanu.</>"

msgctxt "ST_UI,UI_Map_MoveInfoDesc2_Text"
msgid "모든 가구 유지\r\n<ToolTip_Main>새 집에 배치된 기본 가구가 유지된 상태로 입주합니다.</>\r\n<img id=\"Space\"/>\r\n모든 가구 비우기\r\n<ToolTip_Main>새 집에 배치된 기본 가구가 모든 없는 상태로 입주합니다.</><img id=\"Space\"/>\r\n부지 철거\r\n<ToolTip_Main>기존 건물 모두 철거된 빈 부지 상태로 입주합니다. 아파트, 주택가는 일부 외벽이 남아있을 수 있습니다.</>\r\n<img id=\"Space\"/>\r\n<img id=\"Space\"/>\r\n<img id=\"Alert_Blue\"/> <Alert_Blue_Tooltip>거주 중인 가족은 즉시 퇴거 처리 됩니다.</>"
msgstr "Zachowaj wszystkie meble\r\n<ToolTip_Main>Wprowadź się z podstawowymi meblami w nienaruszonym stanie.</>\r\n<img id=\"Space\"/>\r\nWyczyść wszystkie meble\r\n<ToolTip_Main>Wprowadź się z wyczyszczonymi podstawowymi meblami.</><img id=\"Space\"/>\r\nZburz nieruchomość\r\n<ToolTip_Main>Wprowadź się do pustej nieruchomości ze zburzonymi budynkami. Części zewnętrzne niektórych mieszkań i domów mogą pozostać na miejscu.</>\r\n<img id=\"Space\"/>\r\n<img id=\"Space\"/>\r\n<img id=\"Alert_Blue\"/><Alert_Blue_Tooltip>Rodziny zamieszkujące nieruchomość zostaną z niej natychmiast eksmitowane.</>"

msgctxt "ST_UI,UI_Map_MoveOut_Dimmed_Text"
