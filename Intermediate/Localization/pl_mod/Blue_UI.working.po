msgctxt "ST_Widget,Widget_CatOperator_HighestPerspective_Text"
msgid "가장 높은 가치관"
msgstr "Główna wartość"

msgctxt "ST_Widget,Widget_CatOperator_Hope_Text"
msgid "기대"
msgstr "Pragnienia"

msgctxt "ST_Widget,Widget_CatOperator_HopeChange_Text"
msgid "기대 변경"
msgstr "Zmień pragnienia"

msgctxt "ST_Widget,Widget_CatOperator_HopeDesc_Text"
msgid "기대\r\n<img id=\"Space\"/>\r\n<ToolTip_Main>기대는 무언가를 이루고자 하는 조이의 단기적인 바람을 의미합니다. 어린이 시기부터 기대가 형성되며, 달성할 경우 긍정적인 감정 보상과 냥코인 등을 얻게 됩니다.</>"
msgstr "Pragnienia\r\n<img id=\"Space\"/>\r\n<ToolTip_Main>Pragnienia to krótkoterminowe życzenia osiągnięcia jakichś celów. Powstają w dziecińskie. Po zrealizowaniu przyznają pozytywne nagrody emocjonalne, Mru Monety i nie tylko.</>"

msgctxt "ST_Widget,Widget_CatOperator_HopeEffect_Text"
msgid "효과"
msgstr "Efekt"

msgctxt "ST_Widget,Widget_CatOperator_HopeGoalAgeLimitDesc_Text"
msgid "기대\r\n<img id=\"Space\"/>\r\n<ToolTip_Main>기대는 청년 이후부터 선택할 수 있습니다.</>"
msgstr "Pragnienia\r\n<img id=\"Space\"/>\r\n<ToolTip_Main>Możesz wybrać pragnienie od okresu młodego dorosłego.</>"

msgctxt "ST_Widget,Widget_CatOperator_HopeLifeDesc_Info_Text"
msgid "소망하는 삶\r\n<img id=\"Space\"/>\r\n<ToolTip_Main>소망하는 삶은 조이가 살아가고자 하는 삶의 지향점이자 방향성으로, 이루고자 하는 목표와 바람을 반영합니다. 이러한 소망에 따라 조이의 기질, 야망, 가치관이 추천되며, 이는 조이가 추구하는 삶의 방식과 목표를 구체화하는 데 중요한 역할을 합니다. 선택된 요소들은 조이의 길을 견고히 하며 그의 삶에 큰 영향을 줍니다.</>"
msgstr "Upragnione życie\r\n<img id=\"Space\"/>\r\n<ToolTip_Main>Upragnione życie to zarówno kierunek, jak i cel życia Zoi. Kształtowane ambicjami, informuje, które cechy, ambicje i wartości Zoi powinien obrać za cel. W rezultacie elementy te odgrywają kluczową rolę w definiowaniu celów i stylu życia Zoi, prowadząc go przez życie.</>"

msgctxt "ST_Widget,Widget_CatOperator_HopeLifeSortDesc_Text"
msgid "살아가고자 하는 삶의 지향점"
msgstr "Życie, do którego dąży"

msgctxt "ST_Widget,Widget_CatOperator_HopeReason_Text"
msgid "기대 발생 원인"
msgstr "Przyczyna pragnienia"

