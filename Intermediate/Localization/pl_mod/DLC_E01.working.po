msgctxt "ST_MobileMessageSend,MobileMessageSend_PositiveAnswerList_PosAns12_0_AnswerReplyStrIds_PosRepStr12_0_1_Cahaya_Recommended_JoinJobNews_2_MessageStrId"
msgid "네가 그렇게 말해주니까 진짜 실감 나!"
msgstr "Twoje słowa wszystko urzeczywistniają!"

msgctxt "ST_MobileMessageSend,MobileMessageSend_PositiveAnswerList_PosAns12_0_AnswerStrIds_PosAnsStr12_0_0_Cahaya_Recommended_JoinJobNews_2_MessageStrId"
