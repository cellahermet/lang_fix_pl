msgstr "To szalone!!! Serio! Olbrzymie gratulacje!!!"

msgctxt "ST_MobileMessageSend,MobileMessageSend_PositiveAnswerList_PosAns12_2_AnswerReplyStrIds_PosRepStr12_2_0_Cahaya_Recommended_JoinJobNews_2_MessageStrId"
