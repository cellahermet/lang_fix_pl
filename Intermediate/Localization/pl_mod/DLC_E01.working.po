msgstr "Haha, poprawiło mi to humor"

msgctxt "ST_MobileMessageSend,MobileMessageSend_PositiveAnswerList_PosAns12_1_AnswerStrIds_PosAnsStr12_1_0_Cahaya_Recommended_JoinJobNews_2_MessageStrId"
msgid "헐! 그 회사!? 대박! 너 진짜 멋있다!"
msgstr "Co?! Ta firma?! To jest coś! Jesteś super!"

msgctxt "ST_MobileMessageSend,MobileMessageSend_PositiveAnswerList_PosAns12_1_AnswerStrIds_PosAnsStr12_1_1_Cahaya_Recommended_JoinJobNews_2_MessageStrId"
