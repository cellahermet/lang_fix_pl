msgctxt "ST_Object,Object_E01_Ecobag01_DescriptionTextId"
msgid "열대의 생기와 활력을 담은 트로피칼 패턴의 에코백입니다."
msgstr "Ekologiczna torba z tropikalnym wzorem w letnim stylu."

msgctxt "ST_Object,Object_E01_Ecobag01_DisplayNameTextId"
msgid "트로피칼 에코백"
msgstr "Tropikalna torba ekologiczna"

msgctxt "ST_Object,Object_E01_Ecobag01_v01_DescriptionTextId"
msgid "짙은 블루 컬러가 돋보이는 트로피칼 패턴의 에코백입니다."
msgstr "Tropikalna wzorzysta torba ekologiczna w granatowym kolorze."

msgctxt "ST_Object,Object_E01_Ecobag01_v01_DisplayNameTextId"
msgid "블루 트로피칼 에코백"
msgstr "Niebieska ekologiczna torba tropikalna"

msgctxt "ST_Object,Object_E01_Ecobag01_v02_DescriptionTextId"
msgid "고급스러운 로고 디자인이 돋보이는 레스타리 리조트 에코백입니다."
msgstr "Ekologiczna torba z eleganckim logo kurortu Lestari."

msgctxt "ST_Object,Object_E01_Ecobag01_v02_DisplayNameTextId"
msgid "레스타리 에코백"
msgstr "Ekologiczna torba Lestari"

msgctxt "ST_Object,Object_E01_Ecobag01v02_DescriptionTextId"
msgid "고급스러운 로고 디자인이 돋보이는 레스타리 리조트 에코백입니다."
msgstr "Ekologiczna torba z eleganckim logo kurortu Lestari."

msgctxt "ST_Object,Object_E01_Ecobag01v02_DisplayNameTextId"
msgid "레스타리 에코백"
msgstr "Ekologiczna torba Lestari"

msgctxt "ST_Object,Object_E01_Fishball01_DescriptionTextId"
msgid "한 입 물면 담백한 맛을 음미하게 되는 어묵 꼬치입니다."
msgstr "Klasyczny szaszłyk z kotlecikami rybnymi o subtelnym smaku."

msgctxt "ST_Object,Object_E01_Fishball01_DisplayNameTextId"
msgid "어묵 꼬치"
msgstr "Szaszłyk z kotlecikami rybnymi"

msgctxt "ST_Object,Object_E01_FishingRack01_DescriptionTextId"
msgid "낚싯대를 가지런히 정리해 주는 실용적인 우드 거치대입니다."
msgstr "Praktyczny stojak drewniany na wędki."

msgctxt "ST_Object,Object_E01_FishingRack01_DisplayNameTextId"
msgid "낚싯대 거치대 세트"
msgstr "Stojak na wędki"

msgctxt "ST_Object,Object_E01_FishStall01_DescriptionTextId"
msgid "갓 잡아 올린 듯한 신선한 생선과 해산물이 가득한, 바다의 풍미를 그대로 전하는 수산물 판매대입니다."
msgstr "Stoisko z owocami morza pełne świeżo filetowanych ryb i innych produktów z oceanu."

msgctxt "ST_Object,Object_E01_FishStall01_DisplayNameTextId"
msgid "생선 판매대"
msgstr "Stoisko z rybami"

msgctxt "ST_Object,Object_E01_FootBathBasket01_DescriptionTextId"
msgid "스파 공간의 분위기를 한층 더 살려주는 족욕 바구니입니다."
msgstr "Misa do moczenia stóp, która wprowadza spokojną atmosferę do każdego pomieszczenia w spa."

msgctxt "ST_Object,Object_E01_FootBathBasket01_DisplayNameTextId"
msgid "족욕 바구니"
msgstr "Misa do moczenia stóp"

msgctxt "ST_Object,Object_E01_FortunateDrawBox01_DescriptionTextId"
msgid "하루의 운세를 특별하게 전해주는 점괘통입니다."
msgstr "Tuba na patyczki z codziennymi wróżbami."

msgctxt "ST_Object,Object_E01_FortunateDrawBox01_DisplayNameTextId"
msgid "점괘통"
msgstr "Rura z patyczkami"

msgctxt "ST_Object,Object_E01_Fortune_Item01_DescriptionTextId"
msgid "몸에 지니고 있으면 좋은 일이 있을 것만 같은 부적입니다."
msgstr "Talizman, który podobno przynosi szczęście noszącej go osobie."

msgctxt "ST_Object,Object_E01_Fortune_Item01_DisplayNameTextId"
msgid "행운의 고양이 부적"
msgstr "Talizman z kotem"

msgctxt "ST_Object,Object_E01_Frame01_DescriptionTextId"
msgid "섬세한 꽃 드로잉이 어우러진, 따뜻한 분위기의 벽걸이 장식입니다."
msgstr "Dekoracja ścienna w ciepłym odcieniu z delikatnym rysunkiem kwiatów."

msgctxt "ST_Object,Object_E01_Frame01_DisplayNameTextId"
msgid "라탄 프레임 벽 액자"
msgstr "Rama ścienna z rattanu"

msgctxt "ST_Object,Object_E01_Frame02_DescriptionTextId"
msgid "거북 봇 레이스의 DAISY 포스터입니다.\r\n하트 무늬 흉터가 있는 등껍질과 핑크 리본이 매력적인, 모두의 마음을 녹이는 사랑둥이입니다."
msgstr "To plakat wyścigu żółwi z Daisy.\r\nZnak w kształcie serca na skorupie i różowa wstążka sprawiają, że ta słodka żółwica stopi każde serce."

msgctxt "ST_Object,Object_E01_Frame02_DisplayNameTextId"
msgid "거북 봇 DAISY 포스터"
msgstr "Plakat wyścigu żółwi z Daisy"

msgctxt "ST_Object,Object_E01_Frame03_DescriptionTextId"
msgid "거북 봇 레이스의 FRESHY 포스터입니다.\r\n둥근 안경과 쨍한 초록빛 등껍질이 포인트! 지적인 매력을 가진 똑똑이 거북이입니다."
msgstr "To plakat wyścigu żółwi z Freshym.\r\nOkrągłe okulary i jasnozielona skorupa podkreślają intelekt i mądrość tego żółwia!"

msgctxt "ST_Object,Object_E01_Frame03_DisplayNameTextId"
msgid "거북 봇 FRESHY 포스터"
msgstr "Plakat wyścigu żółwi z Freshym"

msgctxt "ST_Object,Object_E01_Frame04_DescriptionTextId"
msgid "거북 봇 레이스의 SPEEDY 포스터입니다.\r\n불가사리 친구와 함께하는 바닷속 스피드왕! 톡톡 튀는 에너지가 매력 포인트입니다."
msgstr "To plakat wyścigu żółwi ze Speedym.\r\nPodwodny struś pędziwiatr z przyjacielem rozgwiazdą! Jego urok bierze się z nieskończonej energii!"

msgctxt "ST_Object,Object_E01_Frame04_DisplayNameTextId"
msgid "거북 봇 SPEEDY 포스터"
msgstr "Plakat wyścigu żółwi ze Speedym"

msgctxt "ST_Object,Object_E01_Frame05_DescriptionTextId"
msgid "거북 봇 레이스의 ROCKY 포스터입니다.\r\n번뜩이는 눈빛과 왕관처럼 당당한 태도! 영리한 머리 회전으로 누구보다 영리하게 승부를 이끄는 전략가 거북이입니다."
msgstr "To plakat wyścigu żółwi z Rockym.\r\nOstre spojrzenie i dumna postawa! Rocky to strategiczny żółw, który prowadzi w wyścigu dzięki sprytowi."

msgctxt "ST_Object,Object_E01_Frame05_DisplayNameTextId"
msgid "거북 봇 ROCKY 포스터"
msgstr "Plakat wyścigu żółwi z Rockym"

msgctxt "ST_Object,Object_E01_Frame06_DescriptionTextId"
msgid "거북 봇 레이스의 단체 포스터입니다.차하야 리조트의 귀여운 거북 봇 친구들!\r\n트랙 위를 누비는 사랑스러운 거북이들의 한 판 승부를 구경해보세요"
msgstr "Plakat grupowy wyścigów żółwi, na którym widać urocze żółwie z Kurortu Cahaya!\r\nPrzyjdź i obejrzyj zmagania tych uwielbianych zwierząt na torze."

msgctxt "ST_Object,Object_E01_Frame06_DisplayNameTextId"
msgid "거북 봇 레이스 포스터"
msgstr "Plakat wyścigu żółwi"

msgctxt "ST_Object,Object_E01_Frame07_DescriptionTextId"
