msgstr "Jesteś niesamowitą osobą!!! Muszę się tobą pochwalić przed wszystkimi!"

msgctxt "ST_MobileMessageSend,MobileMessageSend_PositiveAnswerList_PosAns12_3_AnswerReplyStrIds_PosRepStr12_3_0_Cahaya_Recommended_JoinJobNews_2_MessageStrId"
msgid "같이 기뻐해 줘서 너무 고마워…"
msgstr "Bardzo dziękuję, że ze mną świętujesz…"

msgctxt "ST_MobileMessageSend,MobileMessageSend_PositiveAnswerList_PosAns12_3_AnswerReplyStrIds_PosRepStr12_3_1_Cahaya_Recommended_JoinJobNews_2_MessageStrId"
